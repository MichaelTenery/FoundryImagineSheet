{{!--
	Magic & Lore tab -- his Magic/Lore tab ("e", sheet-magiclore): consumables carried as doses,
	the lores the character knows, spells and invocations. Worked out by module/magic-view.mjs;
	the buttons are module/magic-actions.mjs.

	A lore's group shows when the character holds the skill that learns or uses it, or already knows
	an entry of it -- anything else is under "Add other lore". A kind whose magic switch is off is
	not shown at all. Shift-click a Use or Brew for his MOD buttons' situational modifier.
--}}
<section class="tab imagine-magic{{#if tab.active}} active{{/if}}" data-tab="magic" data-group="primary">

	{{#if magic.magicOff}}
	<p class="empty">All magic is switched off in this campaign (Game Settings &rarr; Content Availability).</p>
	{{else}}

	{{!-- Memorization: (goal + 1) x Knowledge's points, against the ratings of what is ticked. His
	      recalculation complains when there is too much; this line turns red instead. --}}
	<div class="slot-summary magic-summary">
		<span class="slot {{#if magic.memorization.over}}alarm{{/if}}"
			data-tooltip="(goal + 1) &times; {{magic.memorization.perGoal}} from Knowledge. A memorized lore costs its rating; a spell or invocation its level.">
			<label>Memorized</label> {{magic.memorization.used}} / {{magic.memorization.total}} points
			<span class="sub">{{magic.memorization.count}} item(s)</span></span>
		{{#if magic.memorization.over}}<span class="alarm">Too much memorized: forget a few things.</span>{{/if}}
		{{#if magic.isGM}}
		<button type="button" data-action="provideStartingLore"
			data-tooltip="His 'Provide random lore': an entry for every lore skill held, stocks of herbs, potions and poisons, starting spells for a caster">
			<i class="fa-solid fa-dice"></i> Provide starting lore</button>
		{{/if}}
	</div>

	{{!-- What the character has cast or invoked on themselves and is still running -- his effects
	      list. A cross ends one. --}}
	{{#if magic.effects.length}}
	<div class="magic-effects">
		<label>Running:</label>
		{{#each magic.effects as |e|}}<span class="chip">{{e}} <button type="button" class="row-button" data-action="removeMagicEffect"
			data-effect="{{e}}" data-tooltip="It has ended">&times;</button></span>{{/each}}
	</div>
	{{/if}}

	{{!-- @MARKER CONSUMABLES --}}
	{{#if magic.consumables.show}}
	<details class="skill-group magic-group" data-sync open>
		<summary>Consumables <span class="count">{{magic.consumables.rows.length}}</span></summary>
		<div class="gear-add">
			{{#each magic.consumables.add as |a|}}
			<button type="button" data-action="addMagic" data-what="{{a.what}}">Add {{a.label}}</button>
			{{/each}}
		</div>
		{{#if magic.consumables.noIntake}}<p class="muted">This race takes nothing in, so only charms can be added.</p>{{/if}}
		{{#if magic.consumables.rows.length}}
		<table class="skill-table magic-table">
			<thead><tr>
				<th class="col-name">Name</th><th class="col-num">Kind</th><th class="col-num">Doses</th>
				<th class="col-detail">Details</th><th class="col-roll"></th><th class="col-row-actions"></th>
			</tr></thead>
			<tbody>
				{{#each magic.consumables.rows as |r|}}
				<tr data-item-id="{{r.id}}" data-tooltip="{{r.tooltip}}">
					<td class="col-name">{{r.name}}</td>
					<td class="col-num muted">{{r.kindLabel}}</td>
					<td class="col-num">{{#if r.isCharm}}&mdash;{{else}}{{r.doses}}{{/if}}</td>
					<td class="col-detail muted">{{r.detail}}</td>
					<td class="col-roll">
						<button type="button" data-action="useConsumable" {{#unless r.canUse}}disabled{{/unless}}
							data-tooltip="Take one {{#if r.isCharm}}use{{else}}dose{{/if}}">Use</button>
					</td>
					<td class="col-row-actions">
						{{#unless r.isCharm}}<button type="button" class="row-button" data-action="addDose" data-tooltip="One more dose">+</button>{{/unless}}
						<button type="button" class="row-button" data-action="openItem" data-item-id="{{r.id}}" data-tooltip="Open">&#9998;</button>
						<button type="button" class="row-button" data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="Remove">&times;</button>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		{{else}}
		<p class="empty">Nothing carried. Herbs, potions and poisons given at creation land here.</p>
		{{/if}}
	</details>
	{{/if}}

	{{!-- @MARKER LORE --}}
	{{#each magic.loreGroups as |g|}}
	<details class="skill-group magic-group" data-sync open>
		<summary>{{g.heading}} <span class="count">{{g.rows.length}}</span>
			<span class="magic-skill">
				{{#if g.learn}}{{g.learn.name}} {{#if g.learn.held}}{{g.learn.chance}}%{{else}}<span class="muted">not held</span>{{/if}}{{/if}}
				{{#if g.use}} &middot; {{g.use.name}} {{#if g.use.held}}{{g.use.chance}}%{{else}}<span class="muted">not held</span>{{/if}}{{/if}}
				{{#if g.rollSkill.held}} &middot; <span class="muted">practitioner title {{g.rollSkill.practitionerTitle}}</span>{{/if}}
			</span></summary>
		<div class="gear-add">
			{{#if g.isPoisonRecipe}}
			<button type="button" data-action="addMagic" data-what="poisonrecipe">Add a poison recipe</button>
			{{else}}
			<button type="button" data-action="addMagic" data-what="{{g.addWhat}}">{{g.addLabel}}</button>
			{{/if}}
		</div>
		{{#if g.rows.length}}
		<table class="skill-table magic-table">
			<thead><tr>
				<th class="col-name">Name</th>
				{{#unless g.isEvoke}}<th class="col-num" data-tooltip="Memorization cost">Rating</th><th class="col-num">Mod</th>{{/unless}}
				<th class="col-detail">{{#if g.isRecipe}}Details{{else}}{{#if g.isEvoke}}What it does{{else}}Start / lasts{{/if}}{{/if}}</th>
				{{#unless g.isEvoke}}<th class="col-num" data-tooltip="Memorized">Mem</th>{{/unless}}
				<th class="col-roll"></th><th class="col-row-actions"></th>
			</tr></thead>
			<tbody>
				{{#each g.rows as |r|}}
				<tr data-item-id="{{r.id}}" data-tooltip="{{r.tooltip}}">
					<td class="col-name">{{r.name}}</td>
					{{#unless g.isEvoke}}
					<td class="col-num muted">{{r.rating}}</td>
					<td class="col-num muted">{{r.modifier}}</td>
					{{/unless}}
					<td class="col-detail muted">{{#if g.isEvoke}}{{r.tooltip}}{{else}}{{r.timing}}{{#if r.extra}} &middot; {{r.extra}}{{/if}}{{/if}}</td>
					{{#unless g.isEvoke}}
					<td class="col-num"><button type="button" class="row-button mem-toggle {{#if r.memorized}}on{{/if}}" data-action="toggleMemorized"
						data-tooltip="{{#if r.memorized}}Memorized: click to forget{{else}}Known, not memorized: click to memorize{{/if}}">
						{{#if r.memorized}}&#9679;{{else}}&#9675;{{/if}}</button></td>
					{{/unless}}
					<td class="col-roll">
						{{#if g.isRecipe}}
						<button type="button" data-action="brewRecipe" data-tooltip="Brew a batch (Shift: add a modifier)">Brew</button>
						{{else}}
						<button type="button" data-action="useLore" data-tooltip="Roll to use it (Shift: add a modifier)">Use</button>
						{{/if}}
					</td>
					<td class="col-row-actions">
						<button type="button" class="row-button" data-action="openItem" data-item-id="{{r.id}}" data-tooltip="Open">&#9998;</button>
						<button type="button" class="row-button" data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="Remove">&times;</button>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		{{else}}
		<p class="empty">None known yet.</p>
		{{/if}}
	</details>
	{{/each}}

	{{!-- @MARKER SPELLS
	      A spell is cast with the Aura put into it: Aura Control is the most that may go in and the
	      highest level cast safely, the pool what is left. Above Aura Control a spell risks a mishap.
	      Cast asks the Aura and the target (module/casting-actions.mjs). A memorized spell lasts 30
	      days less its level; Sleep takes a day from each, and MEM rolls to refresh one. --}}
	{{#if magic.spells.show}}
	<details class="skill-group magic-group" data-sync open>
		<summary>Spells <span class="count">{{magic.spells.rows.length}}</span>
			{{#if magic.spells.casting}}<span class="magic-skill">{{magic.spells.casting.name}} {{magic.spells.casting.chance}}%
				&middot; <span class="muted">practitioner title {{magic.spells.casting.practitionerTitle}}</span></span>{{/if}}</summary>
		<div class="slot-summary aura-summary">
			<span class="slot" data-tooltip="{{magic.aura.controlTooltip}}"><label>Aura Control</label> {{magic.aura.control}}
				<span class="sub">at most {{magic.aura.controlMax}} at this title</span></span>
			<span class="slot {{#unless magic.aura.pool.current}}alarm{{/unless}}"><label>Aura Pool</label> {{magic.aura.pool.current}} / {{magic.aura.pool.full}}
				{{#if magic.aura.pool.drained}}<span class="sub">{{magic.aura.pool.drained}} drained</span>{{/if}}</span>
			<span class="slot"><label>Regenerates</label> {{magic.aura.regen}}</span>
			{{#if magic.aura.absorbAura}}<span class="slot"><label>Absorb Aura</label> {{magic.aura.absorbAura}}%</span>{{/if}}
			<button type="button" data-action="regenerateAura" data-tooltip="Aura back after a while (his Regen by time)"><i class="fa-solid fa-hourglass-half"></i> Regenerate</button>
			<button type="button" data-action="resetAuraPool" data-tooltip="A full pool (his Reset Aura Pool)"><i class="fa-solid fa-rotate"></i> Reset pool</button>
			<button type="button" data-action="drainAuraPool" data-tooltip="Take Aura from the pool: a skill, an item, a spell cast at the table (his Drain)"><i class="fa-solid fa-droplet-slash"></i> Drain</button>
			<button type="button" data-action="sleepSpells" data-tooltip="A night's sleep: a full pool, and every memorized spell loses a day of memory (his Sleep)"><i class="fa-solid fa-bed"></i> Sleep</button>
		</div>
		<div class="aura-flags">
			<label><input type="checkbox" name="system.magic.magicSuppressed" {{#if magic.aura.suppressed}}checked{{/if}}> Magically suppressed (no casting)</label>
			<label><input type="checkbox" name="system.magic.halfMagic" {{#if magic.aura.halfMagic}}checked{{/if}}> Half magic (Aura Fatigue)</label>
			<label data-tooltip="Additional Aura from items (his additional_aura)">Extra Aura <input type="number" class="short" name="system.magic.additionalAura" value="{{magic.aura.additional}}"></label>
			<label data-tooltip="Aura Control from runes, items and the like (his aura_control_boost)">Aura Control boost <input type="number" class="short" name="system.magic.auraControlBoost" value="{{magic.aura.boost}}"></label>
		</div>
		{{#if magic.aura.fatigueWarning}}<p class="muted">Aura Fatigue: a mortal (under title 11) putting 22 or more Aura into a spell makes an Aura save or suffers it.</p>{{/if}}
		{{#if magic.aura.hermetic}}<p class="muted">Hermetic Lore casts through a ritual of ingredients, which is not built yet: the Game Master settles a Hermeticist's casting.</p>{{/if}}
		<div class="gear-add">
			<button type="button" data-action="addMagic" data-what="spell">Add a spell</button>
		</div>
		{{#if magic.spells.rows.length}}
		<table class="skill-table magic-table">
			<thead><tr>
				<th class="col-name">Spell</th><th class="col-num">Level</th><th class="col-detail">Cast / range / lasts</th>
				<th class="col-num" data-tooltip="Mastered: +2 Aura Control, half the time, triple range, double duration">Mst</th>
				<th class="col-num">Mem</th>
				<th class="col-num" data-tooltip="Days of memory left: 30 less the level when memorized, one lost at each Sleep">Days</th>
				<th class="col-roll"></th><th class="col-row-actions"></th>
			</tr></thead>
			<tbody>
				{{#each magic.spells.rows as |r|}}
				<tr data-item-id="{{r.id}}" data-tooltip="{{r.tooltip}}">
					<td class="col-name">{{r.name}}{{#if r.aboveControl}} <span class="alarm" data-tooltip="Above Aura Control: a {{r.failChance}}% chance of a magical mishap">!</span>{{/if}}
						{{#if r.forgotten}} <span class="alarm" data-tooltip="Out of days: forgotten until MEM refreshes it">forgotten</span>{{/if}}</td>
					<td class="col-num muted">{{r.level}}</td>
					<td class="col-detail muted">{{r.castTime}} &middot; {{r.range}} &middot; {{r.duration}}{{#if r.save}}{{#unless (eq r.save "None")}} &middot; {{r.save}}{{/unless}}{{/if}}</td>
					<td class="col-num"><button type="button" class="row-button mem-toggle {{#if r.mastered}}on{{/if}}" data-action="toggleMastered"
						data-tooltip="{{#if r.mastered}}Mastered: click to unmark{{else}}Not mastered{{/if}}">{{#if r.mastered}}&#9733;{{else}}&#9734;{{/if}}</button></td>
					<td class="col-num"><button type="button" class="row-button mem-toggle {{#if r.memorized}}on{{/if}}" data-action="toggleMemorized"
						data-tooltip="{{#if r.memorized}}Memorized: click to forget (its days go too){{else}}Tick without a roll; MEM rolls for it{{/if}}">{{#if r.memorized}}&#9679;{{else}}&#9675;{{/if}}</button></td>
					<td class="col-num {{#if r.forgotten}}alarm{{else}}muted{{/if}}">{{#if r.memorized}}{{r.days}}{{else}}&mdash;{{/if}}</td>
					<td class="col-roll">
						<button type="button" data-action="rememorizeSpell"
							data-tooltip="Rememorize with the casting skill: its full days again. Takes {{r.memTime}} (Shift: add a modifier)">Mem</button>
						<button type="button" data-action="castSpell" {{#unless r.memorized}}disabled{{/unless}}{{#if r.forgotten}} disabled{{/if}}
						data-tooltip="{{#if r.forgotten}}Forgotten: rememorize it first{{else}}{{#if r.memorized}}Cast it: choose the Aura, and target tokens first to cast at them{{else}}Memorize it first{{/if}}{{/if}}">Cast</button></td>
					<td class="col-row-actions">
						<button type="button" class="row-button" data-action="postMagic" data-tooltip="Read it out to chat"><i class="fa-solid fa-comment"></i></button>
						<button type="button" class="row-button" data-action="openItem" data-item-id="{{r.id}}" data-tooltip="Open">&#9998;</button>
						<button type="button" class="row-button" data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="Remove">&times;</button>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		{{else}}
		<p class="empty">No spells known.</p>
		{{/if}}
		<p class="muted">Not built yet: spell tuning (speed, stabilize, overload, Aura reach, burning Aura), combined casting,
			specialization and Hermetic rituals.</p>
	</details>
	{{/if}}

	{{!-- @MARKER INVOCATIONS
	      An invocation is prayed for with Divine Knowledge (which memorizes it and gives it its uses)
	      and invoked at the Piety level: Piety Control plus any boost. --}}
	{{#if magic.invocations.show}}
	<details class="skill-group magic-group" data-sync open>
		<summary>Invocations <span class="count">{{magic.invocations.rows.length}}</span>
			{{#if magic.invocations.knowledge}}<span class="magic-skill">{{magic.invocations.knowledge.name}} {{magic.invocations.knowledge.chance}}%</span>{{/if}}</summary>
		<div class="slot-summary aura-summary">
			<span class="slot" data-tooltip="{{magic.piety.controlTooltip}}"><label>Piety Control</label> {{magic.piety.control}}</span>
			<span class="slot"><label>Piety level</label> {{magic.piety.level}}</span>
			<label class="aura-flags" data-tooltip="Piety level from items and the like (his piety_level_boost)">Boost
				<input type="number" class="short" name="system.magic.pietyLevelBoost" value="{{magic.piety.boost}}"></label>
		</div>
		<div class="aura-flags">
			<label><input type="checkbox" name="system.magic.divineDenial" {{#if magic.piety.denial}}checked{{/if}}> Divine Denial (24 hours)</label>
			<label data-tooltip="Comma-separated: Body, Celestial, Combat, Control, Divination, Elemental, General, Healing, Mind, Nature, Necromancy, Protection, Summoning">Devotions
				<input type="text" name="system.magic.devotions" value="{{magic.piety.devotions}}" placeholder="General, Healing"></label>
			<label><input type="checkbox" name="system.magic.ignoreDevotions" {{#if magic.piety.ignoreDevotions}}checked{{/if}}> Ignore devotions</label>
		</div>
		<div class="gear-add">
			<button type="button" data-action="addMagic" data-what="invocation">Add an invocation</button>
		</div>
		{{#if magic.invocations.rows.length}}
		<table class="skill-table magic-table">
			<thead><tr>
				<th class="col-name">Invocation</th><th class="col-num">Level</th><th class="col-detail">Align / invoke / lasts</th>
				<th class="col-num" data-tooltip="Uses left from the last prayer">Uses</th>
				<th class="col-num">Mem</th><th class="col-roll"></th><th class="col-row-actions"></th>
			</tr></thead>
			<tbody>
				{{#each magic.invocations.rows as |r|}}
				<tr data-item-id="{{r.id}}" data-tooltip="{{r.tooltip}}">
					<td class="col-name">{{r.name}}{{#if r.overControl}} <span class="alarm" data-tooltip="Its Piety Level is above Piety Control: it cannot be prayed for">!</span>{{/if}}</td>
					<td class="col-num muted">{{r.level}}</td>
					<td class="col-detail muted">{{r.alignment}} &middot; {{r.invokeTime}} &middot; {{r.duration}}</td>
					<td class="col-num">{{r.usesLeft}}</td>
					<td class="col-num"><button type="button" class="row-button mem-toggle {{#if r.memorized}}on{{/if}}" data-action="toggleMemorized"
						data-tooltip="Prayer time {{r.prayerTime}}">{{#if r.memorized}}&#9679;{{else}}&#9675;{{/if}}</button></td>
					<td class="col-roll">
						<button type="button" data-action="prayForInvocation" data-tooltip="{{#if r.memorized}}Repray for new uses{{else}}Pray for it{{/if}} with Divine Knowledge (Shift: add a modifier)">Pray</button>
						<button type="button" data-action="invokeInvocation" {{#unless r.usesLeft}}disabled{{/unless}}
							data-tooltip="{{#if r.usesLeft}}Invoke it: target tokens first to invoke at them{{else}}No uses left: pray for it{{/if}}">Invoke</button>
					</td>
					<td class="col-row-actions">
						<button type="button" class="row-button" data-action="postMagic" data-tooltip="Read it out to chat"><i class="fa-solid fa-comment"></i></button>
						<button type="button" class="row-button" data-action="openItem" data-item-id="{{r.id}}" data-tooltip="Open">&#9998;</button>
						<button type="button" class="row-button" data-action="deleteItem" data-item-id="{{r.id}}" data-tooltip="Remove">&times;</button>
					</td>
				</tr>
				{{/each}}
			</tbody>
		</table>
		{{else}}
		<p class="empty">No invocations known.</p>
		{{/if}}
	</details>
	{{/if}}

	{{!-- Anything the character has no skill for, still addable: a Game Master handing out a scroll
	      of runes, a found spellbook, a hymn taught by a temple. --}}
	{{#if magic.otherLore.length}}
	<div class="magic-other">
		<label>Add other lore
			<select>
				{{#each magic.otherLore as |o|}}<option value="{{o.what}}">{{o.label}}</option>{{/each}}
			</select></label>
		<button type="button" data-action="addOtherMagic">Add</button>
	</div>
	{{/if}}

	{{#if magic.nothingYet}}
	<p class="muted">This character holds no lore skill and carries nothing magical yet.
		{{#if magic.isGM}}"Provide starting lore" gives what his character creation would have.{{/if}}</p>
	{{/if}}

	{{/if}}
</section>

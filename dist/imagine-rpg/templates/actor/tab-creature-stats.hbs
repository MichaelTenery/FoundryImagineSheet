{{!--
	Stats tab. One root element, as the framework requires of every PART.

	The attributes work exactly as a character's -- rating in, save and table modifiers out. What
	differs is everything in the panels below: a creature's Endurance, Hide, Shock and all five
	resistances are figures its stat block states, so they are inputs here rather than readouts.

	The movement modes are the creature's own list, edited in place (his Configurator's movement
	rows, HTML 81003-81007); the jumps are worked out from Agility, as his setCreatureMovementValues
	does, with his two jump modifiers beside them. The Modifiers panel at the foot holds every manual
	adjustment the schema carries -- his GM Tools' temporary modifiers.
--}}
<section class="tab imagine-creature-stats{{#if tab.active}} active{{/if}}" data-tab="stats" data-group="primary">

	<table class="attribute-table">
		<thead>
			<tr>
				<th class="col-name">Attribute</th>
				<th class="col-num">Rating</th>
				<th class="col-num">Value</th>
				<th class="col-num">Max</th>
				<th class="col-num">Save</th>
				<th class="col-roll"></th>
				<th class="col-mods">Modifiers</th>
			</tr>
		</thead>
		<tbody>
			{{#each attributes as |attr|}}
			<tr class="attribute-row" data-group-name="{{attr.group}}">
				<td class="col-name">{{localize attr.label}}</td>
				<td class="col-num">
					<input type="number" name="system.attributes.{{attr.key}}.rating" value="{{attr.rating}}">
				</td>
				<td class="col-num derived">{{attr.value}}</td>
				<td class="col-num derived muted">{{attr.max}}</td>
				<td class="col-num derived strong">{{attr.save}}%</td>
				<td class="col-roll">
					<button type="button" data-action="rollAttributeSave" data-attribute="{{attr.key}}">Roll</button>
				</td>
				<td class="col-mods">
					{{#each attr.mods as |mod|}}<span class="mod"><em>{{mod.key}}</em> {{mod.value}}</span>{{/each}}
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>

	<div class="panel-row">

		<div class="panel">
			<h3>Characteristics</h3>
			{{!-- Entered, not calculated: see the data model's comments. --}}
			<ul class="band-list">
				<li><label>Endurance</label>
					<span><input type="number" name="system.characteristics.endurance.entered"
						value="{{system.characteristics.endurance.entered}}"></span></li>
				<li><label>Hide</label>
					<span><input type="number" name="system.body.hide" value="{{system.body.hide}}"></span></li>
				<li><label>Shock</label>
					<span><input type="number" name="system.characteristics.shock.entered"
						value="{{system.characteristics.shock.entered}}"></span></li>
				<li><label class="muted">Shock immune</label>
					<span><input type="checkbox" name="system.characteristics.shock.immune"
						{{#if system.characteristics.shock.immune}}checked{{/if}}></span></li>
				{{!-- His Configurator's tame bonus (HTML 80983), added straight to Affinity. --}}
				<li><label>Tame bonus</label>
					<span><input type="number" name="system.tameBonus" value="{{system.tameBonus}}"></span></li>
			</ul>
			<p class="muted">Shock left at 0 becomes Endurance &times; 3.</p>
			{{#if system.body.hideOverCap}}
			<p class="alarm">Hide {{system.body.hide}} is over his errata's cap of {{system.body.hideMax}}
				(5 per level, level 0 as 1). Plants, magical plants and Titanic creatures are exempt.
				The figure is kept as entered; lower it, or set the size or type if it is exempt.</p>
			{{/if}}
		</div>

		<div class="panel">
			<h3>Resistances</h3>
			<ul class="resist-list">
				{{#each system.resistances as |res key|}}
				<li><label>{{key}}</label>
					<span><input type="number" name="system.resistances.{{key}}.entered" value="{{res.entered}}"></span>
					<span class="value">{{#if res.immune}}Immune{{else}}{{res.value}}%{{/if}}</span>
					<span class="muted"><input type="checkbox" name="system.resistances.{{key}}.immune"
						{{#if res.immune}}checked{{/if}}> imm</span>
					<button type="button" data-action="rollResistance" data-resistance="{{key}}"
						data-tooltip="Roll &mdash; shift-click for a modifier">Roll</button>
				</li>
				{{/each}}
			</ul>
		</div>

		<div class="panel">
			<h3>Movement
				<button type="button" class="add-language" data-action="addMovement" data-tooltip="Add a movement mode">
					<i class="fa-solid fa-plus"></i> Add</button>
			</h3>
			{{#if movementRows.length}}
			<table class="edit-move-table">
				<thead><tr><th>Mode</th><th>Hour</th><th>10 sec</th><th>1 sec</th><th></th></tr></thead>
				<tbody>
					{{#each movementRows as |m|}}
					<tr>
						<td><input type="text" name="system.movement.modes.{{m.index}}.name" value="{{m.name}}" placeholder="Walk"></td>
						<td><input type="number" step="any" name="system.movement.modes.{{m.index}}.hourly" value="{{m.hourly}}"></td>
						<td><input type="number" step="any" name="system.movement.modes.{{m.index}}.tenSec" value="{{m.tenSec}}"></td>
						<td><input type="number" step="any" name="system.movement.modes.{{m.index}}.oneSec" value="{{m.oneSec}}"></td>
						<td class="col-row-actions">
							{{#unless m.first}}<button type="button" class="row-button" data-action="moveMovement" data-index="{{m.index}}" data-offset="-1" data-tooltip="Move up">&uarr;</button>{{/unless}}
							{{#unless m.last}}<button type="button" class="row-button" data-action="moveMovement" data-index="{{m.index}}" data-offset="1" data-tooltip="Move down">&darr;</button>{{/unless}}
							<button type="button" class="row-button" data-action="removeMovement" data-index="{{m.index}}" data-tooltip="Remove this mode">&times;</button>
						</td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			<p class="muted">Slowest first, special modes (fly, swim, burrow) last.</p>
			{{else}}
			<p class="empty">No movement recorded. Add a mode for each way it moves.</p>
			{{/if}}
			{{!-- Worked out from Agility (his switch, sheet-worker.js:178893-179003), plus the modifier. --}}
			<ul class="band-list">
				<li><label>Standing jump</label> <span>{{system.movement.jumpStand}}'
					<span class="muted">(Agility {{system.movement.jumpStandBase}}')</span></span></li>
				<li><label>Jump up</label> <span>{{system.movement.jumpUp}}'
					<span class="muted">(Agility {{system.movement.jumpUpBase}}')</span></span></li>
			</ul>
		</div>

		<div class="panel">
			<h3>Size and Load</h3>
			<ul class="band-list">
				<li><label>Height</label>
					<span><input type="number" name="system.physical.heightFeet" value="{{system.physical.heightFeet}}">ft
					      <input type="number" name="system.physical.heightInches" value="{{system.physical.heightInches}}">in</span></li>
				<li><label>Weight</label>
					<span><input type="number" name="system.physical.weight" value="{{system.physical.weight}}"> lb</span></li>
			</ul>
			<p class="encumbrance-status">{{system.encumbrance.status}}</p>
			<p class="muted">{{system.encumbrance.carried}} / {{system.encumbrance.maxLoad}} lb</p>
			{{!-- What the load actually costs. The character sheet has shown this since the
			      encumbrance pass; the creature sheet showed the status and the weight but never
			      the penalty, which is the part that changes play. --}}
			{{#if system.encumbrance.penalty}}
			<p class="muted">{{system.encumbrance.penalty}}</p>
			{{/if}}
			{{!-- Body weight is also a damage modifier (Player's Guide p.179), floored at 0 for a
			      creature; see the Damage box on the Combat tab. --}}
			{{#if system.combat.weightDamage}}
			<p class="muted">Its weight adds +{{system.combat.weightDamage}} to its damage.</p>
			{{/if}}
		</div>
	</div>

	{{!-- @MARKER MODIFIERS PANEL
	      Every manual adjustment the creature's schema carries, none of which any template showed before
	      2026-09-23. Closed by default; its state is the sheet's own (toggleModifiers). --}}
	<h3 class="section-head">
		<button type="button" class="creature-modifiers-toggle" data-action="toggleModifiers">
			<i class="fa-solid {{#if modifiersOpen}}fa-caret-down{{else}}fa-caret-right{{/if}}"></i> Modifiers</button>
		<span class="muted">temporary and permanent adjustments, the Game Master's</span>
	</h3>
	{{#if modifiersOpen}}
	<div class="panel-row creature-modifiers">
		<div class="panel">
			<h3>Attributes</h3>
			<table class="modifier-table">
				<thead><tr><th></th><th class="col-num">Perm</th><th class="col-num">Temp</th></tr></thead>
				<tbody>
					{{#each modifiers.attributes as |a|}}
					<tr><td>{{a.label}}</td>
						<td class="col-num"><input type="number" name="system.attributes.{{a.key}}.permMod" value="{{a.permMod}}"></td>
						<td class="col-num"><input type="number" name="system.attributes.{{a.key}}.tempMod" value="{{a.tempMod}}"></td></tr>
					{{/each}}
				</tbody>
			</table>
			<p class="muted">Moves the attribute's value and save. Perception, Affinity and Fortune read the
				ratings, as his formulas do, so these do not move them.</p>
		</div>
		<div class="panel">
			<h3>Characteristics</h3>
			<table class="modifier-table">
				<tbody>
					{{#each modifiers.characteristics as |c|}}
					<tr><td>{{c.label}}</td>
						<td class="col-num"><input type="number" name="system.characteristics.{{c.key}}.tempMod" value="{{c.tempMod}}"></td></tr>
					{{/each}}
				</tbody>
			</table>
			<h3>Resistances</h3>
			<table class="modifier-table">
				<thead><tr><th></th><th class="col-num">Perm</th><th class="col-num">Temp</th></tr></thead>
				<tbody>
					{{#each modifiers.resistances as |r|}}
					<tr><td>{{r.label}}</td>
						<td class="col-num"><input type="number" name="system.resistances.{{r.key}}.permMod" value="{{r.permMod}}"></td>
						<td class="col-num"><input type="number" name="system.resistances.{{r.key}}.tempMod" value="{{r.tempMod}}"></td></tr>
					{{/each}}
				</tbody>
			</table>
		</div>
		<div class="panel">
			<h3>Combat</h3>
			<table class="modifier-table">
				<tbody>
					{{#each modifiers.combat as |m|}}
					<tr><td data-tooltip="{{m.note}}">{{m.label}}</td>
						<td class="col-num"><input type="number" name="system.combat.{{m.key}}" value="{{m.value}}"></td></tr>
					{{/each}}
				</tbody>
			</table>
			<h3>Jumps</h3>
			<table class="modifier-table">
				<tbody>
					<tr><td>Standing jump (ft)</td>
						<td class="col-num"><input type="number" step="any" name="system.movement.jumpStandMod" value="{{system.movement.jumpStandMod}}"></td></tr>
					<tr><td>Jump up (ft)</td>
						<td class="col-num"><input type="number" step="any" name="system.movement.jumpUpMod" value="{{system.movement.jumpUpMod}}"></td></tr>
				</tbody>
			</table>
		</div>
	</div>
	{{/if}}

	<h3 class="section-head">Notes</h3>
	<textarea name="system.notes" rows="3">{{system.notes}}</textarea>
	<div class="panel-row">
		<label class="creature-note">Experience note
			<input type="text" name="system.identity.expNote" value="{{system.identity.expNote}}"></label>
	</div>
	<h3 class="section-head">Description</h3>
	<textarea name="system.biography" rows="5">{{system.biography}}</textarea>
</section>

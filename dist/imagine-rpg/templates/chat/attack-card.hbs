{{!--
	Weapon attack chat card. Shows the roll the way his sheet's verbose attack output did: the
	natural roll, every modifier by name, the result read against the attack chart, and where
	the blow landed -- then the damage, and the buttons to apply it and spend the time.
--}}
<div class="imagine-chat attack-card">
	<header>
		<strong>{{actorName}}</strong> — {{#if weaponDisplay}}{{weaponDisplay}}{{else}}{{weapon}}{{/if}} ({{modeLabel}})
		{{#if targetName}}<span class="target">vs {{targetName}}</span>{{/if}}
	</header>

	<div class="attack-line">
		<span class="natural">d20: {{result.natural}}</span>
		{{#each mods.list as |m|}}<span class="mod">{{m.label}} {{#if (gt m.value 0)}}+{{/if}}{{m.value}}</span>{{/each}}
		<span class="final">= {{result.final}}</span>
		<span class="skill">as {{result.skill}}</span>
	</div>

	{{#if aim}}<div class="aim">Aimed at: {{aim}}</div>{{/if}}

	{{!-- The Situation Mods this attack read, by name, and the ones that are for the table to act
	      on rather than arithmetic -- a Random Location, half reload time. --}}
	{{#if situation.labels.length}}<div class="situation">Situation: {{#each situation.labels as |l|}}{{l}}{{#unless @last}}, {{/unless}}{{/each}}</div>{{/if}}
	{{#if situation.notes.length}}<div class="situation-notes">{{#each situation.notes as |n|}}<strong>{{n}}</strong>{{#unless @last}} &middot; {{/unless}}{{/each}}</div>{{/if}}
	{{!-- The stance's and moves' own words, which his card printed beside the modifiers. --}}
	{{#if martialNotes.length}}<div class="situation-notes">{{#each martialNotes as |n|}}{{n}}{{#unless @last}} &middot; {{/unless}}{{/each}}</div>{{/if}}

	<div class="zone zone-{{#if result.isHit}}hit{{else}}miss{{/if}}">
		{{#if result.isFumble}}FUMBLE{{else}}{{result.zone}}{{/if}}
		{{#if result.calledShotDeclared}}
			— Called shot: {{#if result.isCalledShot}}<strong>made</strong>{{else}}missed{{/if}}
		{{/if}}
	</div>

	{{#if fumble}}<p class="fumble">{{fumble.text}}</p>{{/if}}

	{{#if damage}}
	<div class="damage">
		<span class="total">{{damage.total}}</span> {{damage.type}} damage
		<span class="breakdown">({{damage.dice}}{{#if damage.str}} {{#if (gt damage.str 0)}}+{{/if}}{{damage.str}} STR{{/if}}{{#if damage.magic}} +{{damage.magic}} magic{{/if}}{{#if damage.lore}} {{#if (gt damage.lore 0)}}+{{/if}}{{damage.lore}} lore{{#if damage.loreSpecific}} (specific){{/if}}{{/if}}{{#if damage.projectileLore}} {{#if (gt damage.projectileLore 0)}}+{{/if}}{{damage.projectileLore}} projectile lore ({{damage.projectileLorePerDie}}/die){{/if}}{{#if damage.multiMissile}} {{damage.multiMissile}} multiple missiles{{/if}}{{#if damage.offhand}} {{damage.offhand}} off hand{{#if (eq damage.offhandTier "knowledge")}} (Second Weapon Knowledge){{/if}}{{/if}}{{#if damage.situation}} {{#if (gt damage.situation 0)}}+{{/if}}{{damage.situation}} situational{{/if}}{{#if damage.martial}} {{#if (gt damage.martial 0)}}+{{/if}}{{damage.martial}} martial{{/if}}{{#if damage.runeDice}} +{{damage.runeDice}} rune{{/if}}{{#if damage.custom}} {{#if (gt damage.custom 0)}}+{{/if}}{{damage.custom}} weapon{{/if}}{{#if damage.special}} +{{damage.special}} magical{{/if}}{{#if damage.specialDoubles}}, doubled by the natural roll{{/if}}{{#if damage.maximized}}, every die at its highest{{/if}}{{#if damage.misc}} {{#if (gt damage.misc 0)}}+{{/if}}{{damage.misc}}{{/if}}
		= {{damage.rolled}}{{#if (gt damage.situationMulti 1)}}, x{{damage.situationMulti}} situational{{/if}}{{#if (gt damage.martialMulti 1)}}, x{{damage.martialMulti}} martial{{/if}}{{#if damage.halfDamage}}, halved for the failed shot{{/if}}{{#if (lt damage.multiplier 1)}}{{#unless damage.halfDamage}}, halved for the called shot{{/unless}}{{/if}})</span>
		{{!-- Two or three projectiles are one roll; the rest land on the same target for the same
		      damage again, which is his sheet's rule and not the book's. --}}
		{{#if (gt damage.shots 1)}}
		<span class="breakdown">{{damage.perShot}} each &times; {{damage.shots}} projectiles{{#if damage.multiMissileTier}} &mdash; {{damage.multiMissileTier}}{{/if}}</span>
		{{/if}}
	</div>
	{{/if}}

	{{!-- What the weapon's customization does on a hit that is the table's to settle: Foe Strike's
	      figure against its foe type, energy and divine damage behind a Magic Resistance, Bane. --}}
	{{#if weaponSpecials.length}}
	<div class="weapon-specials">{{#each weaponSpecials as |s|}}<p>{{s}}</p>{{/each}}</div>
	{{/if}}

	{{!-- A poison on the weapon: delivered by a hit that reaches the flesh, or from an Envenomed
	      hilt by a thrust of 10 or more, when the damage is applied (lore-rules.mjs, POISON ON A WEAPON). --}}
	{{#if coating}}{{#if damage}}
	<div class="situation-notes">Poisoned: {{coating.name}}{{#if coating.envenomed}} &mdash; {{coating.doses}} dose(s) in the Envenomed hilt; a thrust of 10 or more delivers one{{else}} &mdash; goes in if the blow reaches the flesh{{/if}}</div>
	{{/if}}{{/if}}

	<footer>
		<span class="speed">{{speed}} seconds</span>
		{{#if damage}}{{#unless applied}}
			<button type="button" data-imagine-action="applyDamage"><i class="fa-solid fa-droplet"></i> Apply damage</button>
		{{/unless}}{{/if}}
		{{#if inCombat}}
			<button type="button" data-imagine-action="spendTime"><i class="fa-solid fa-stopwatch"></i> Spend {{speed}}s</button>
		{{/if}}
	</footer>
</div>

{{!--
	Invocation body. One root element, as every PART must be.

	Every column of his invocationslist. "Uses per PC" is what each point of Piety Control buys when it
	is prayed for (his addUsageByName), and a duration in Piety Control is worked out when it is
	invoked (the Magic & Lore tab's Invoke button, his own doInvocationAction).
--}}
<section class="imagine-item-body invocation">

	<div class="panel-row">
		<div class="panel">
			<h3>The invocation</h3>
			<ul class="band-list">
				<li><label>Level</label>
					<span><input type="number" name="system.level" value="{{system.level}}" min="0"></span></li>
				<li><label>Alignment</label>
					<span><input type="text" name="system.alignment" value="{{system.alignment}}"></span></li>
				<li><label>Save</label>
					<span><input type="text" name="system.save" value="{{system.save}}"></span></li>
				<li><label>Uses per PC</label>
					<span><input type="text" name="system.uses" value="{{system.uses}}"></span></li>
				<li><label>Memorized</label>
					<span><input type="checkbox" name="system.memorized" {{#if system.memorized}}checked{{/if}}></span></li>
				<li><label>Uses left</label>
					<span><input type="number" name="system.usesLeft" value="{{system.usesLeft}}" min="0"></span></li>
			</ul>
		</div>

		<div class="panel">
			<h3>Invoking</h3>
			<ul class="band-list">
				<li><label>Prayer time</label>
					<span><input type="text" name="system.prayerTime" value="{{system.prayerTime}}"></span></li>
				<li><label>Invoke time</label>
					<span><input type="text" name="system.invokeTime" value="{{system.invokeTime}}"></span></li>
				<li><label>Range</label>
					<span><input type="text" name="system.range" value="{{system.range}}"></span></li>
				<li><label>Area</label>
					<span><input type="text" name="system.area" value="{{system.area}}"></span></li>
				<li><label>Duration</label>
					<span><input type="text" name="system.duration" value="{{system.duration}}"></span></li>
				<li><label>Distance</label>
					<span><input type="text" name="system.distance" value="{{system.distance}}"></span></li>
			</ul>
		</div>
	</div>

	<h3 class="section-head">Description</h3>
	<textarea name="system.description" rows="8">{{system.description}}</textarea>
</section>

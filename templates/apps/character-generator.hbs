{{!--
	Character generator. One step at a time, in his order (module/chargen-view.mjs lists them).
	Only the current step's inputs are rendered, so capturing the form merges that step's choices
	without disturbing any other step's. Everything shown is worked out by buildGeneratorView.
--}}
<div class="imagine chargen">

	<ol class="chargen-steps">
		{{#each steps as |s|}}
		<li class="{{#if s.current}}current{{/if}} {{#if s.done}}done{{/if}}">
			<button type="button" data-action="goToStep" data-step="{{s.index}}" {{#unless s.done}}{{#unless s.current}}disabled{{/unless}}{{/unless}}>{{s.name}}</button>
		</li>
		{{/each}}
	</ol>

	<section class="chargen-body">

	{{!-- @MARKER BASICS --}}
	{{#if isBasics}}
		<h2>Who is this?</h2>
		<label class="row">Name <input type="text" name="name" value="{{state.name}}" placeholder="New Character"></label>
		<label class="row">Gender <input type="text" name="gender" value="{{state.gender}}"></label>
		{{!-- NOT gendered. The original rules gave this to every female; he cut it loose when he
		      built the Roll20 sheet, so it is any character's to take -- a slighter male and a
		      stronger female are both ordinary. Confirmed 2026-09-20. --}}
		<label class="row check"><input type="checkbox" name="slightPhysique" {{#if slightPhysique}}checked{{/if}} {{#if physiqueLocked}}disabled{{/if}}>
			Slight physique: &minus;1 Strength, +1 Agility</label>
		{{#if physiqueReason}}<p class="{{#if physiqueConflict}}alarm{{else}}muted{{/if}}">{{physiqueReason}}</p>
		{{else}}<p class="muted">Anyone may take this, whatever their gender. It decides more than the
		two points for a Gremlin, whose ordinary form gains Climb; and for the faerie races it is not
		offered at all, because their winged and wingless forms are races of their own.</p>{{/if}}
		<label class="row">Character type
			<select name="charType">{{#each charTypes as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
		<p class="muted">Ask the Game Master which type the campaign uses. Rolls are kept per attribute; each type lets points be moved between attributes at its ratio later.</p>
	{{/if}}

	{{!-- @MARKER RACE --}}
	{{#if isRace}}
		<h2>Race</h2>
		<label class="row">Race
			<select name="race1">{{#each race1Options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
		{{#if canBeHalf}}
		<label class="row">{{#if isFormless}}Host body{{else}}Half Race with{{/if}}
			<select name="race2">{{#each race2Options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
		{{#if isFormless}}
		<p class="muted">A Formless has no body of its own; the host supplies it. Choose any of the races his sheet allows it to inhabit.</p>
		{{else}}
		<p class="muted">Only races that can have children with the first are offered, as on his sheet. The two combine as his half race does: a modifier only one race has is taken whole, shared ones averaged.</p>
		{{/if}}
		{{else}}{{#if state.race1}}<p class="muted">This race cannot have children with other races, so it cannot be half of a Half Race.</p>{{/if}}
		{{/if}}
		{{#if formlessIssue}}<p class="alarm">{{formlessIssue}}</p>{{/if}}
		{{#if race}}
		<div class="chargen-race">
			<h3>{{raceName}}</h3>
			<p>Body {{race.bodyType}}. Starting age {{race.ages.startLow}}&ndash;{{race.ages.startHigh}}, maximum {{race.ages.maxAge}}.</p>
			{{#if race.abilities.length}}<p><label>Abilities</label> {{#each race.abilities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
			{{#if race.disabilities.length}}<p><label>Disabilities</label> {{#each race.disabilities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
			{{#if race.immunities.length}}<p><label>Immunities</label> {{#each race.immunities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
		</div>
		{{/if}}

		{{!-- @MARKER FAMORIAN --}}
		{{#if isFamorian}}
		<div class="chargen-race">
			<h3>Famorian</h3>
			{{#if famorianBreedSelectable}}
			<label class="row">Breed
				<select name="famorianBreed"><option value="">-- choose --</option>{{#each famorianBreedOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
				<button type="button" data-action="rollFamorianBreed"><i class="fa-solid fa-dice"></i> Roll</button></label>
			{{else}}
			<p>Breed: <span class="rolled-value">{{#if famorianBreed}}{{famorianBreed}}{{else}}&mdash; rolled once a race is chosen &mdash;{{/if}}</span>
				<span class="muted">rolled once, and it stands</span></p>
			{{/if}}
			<label class="row">Animal type <input type="text" name="famorianAnimalType" value="{{state.famorian.animalType}}"></label>
			<p class="muted">His sheet will not apply the race until this is filled in.</p>

			<h4>Evokes <span class="muted">{{famorianBudget.used}} of {{famorianBudget.allowedLabel}}</span></h4>
			{{#if famorianBudget.issue}}<p class="alarm">{{famorianBudget.issue}}</p>{{/if}}
			<p class="muted">Strength, Agility and Vitality add a rolled 1d3 each when taken. Twelve more change Endurance, a resistance, movement, the speed multiplier or the jump; the rest are abilities with no figure attached.</p>
			<div class="pick-list tall famorian-evoke-list">
				{{#each famorianEvokes as |e|}}
				<label class="{{#if e.numeric}}famorian-numeric{{/if}}"><input type="checkbox" name="famorianEvoke" value="{{e.key}}" {{#if e.checked}}checked{{/if}}> {{e.label}}{{#if e.detail}} <span class="muted">&mdash; {{e.detail}}</span>{{/if}}</label>
				{{/each}}
			</div>
		</div>
		{{/if}}
	{{/if}}

	{{!-- @MARKER ATTRIBUTES --}}
	{{#if isAttributes}}
		<h2>Attributes <span class="muted">{{typeLabel}}, {{ratio}}:1</span></h2>
		<p>
			<button type="button" data-action="rollAttributes"><i class="fa-solid fa-dice"></i> Roll {{typeLabel}}</button>
			<label class="check"><input type="checkbox" name="manual" {{#if state.manual}}checked{{/if}}> Enter them instead</label>
		</p>
		<table class="chargen-attributes">
			<thead><tr><th></th>{{#if state.manual}}<th>Entered</th>{{else}}<th>Rolls</th><th>Best</th>{{/if}}
				<th>Rating</th><th>Race</th><th>Final</th><th>Max</th></tr></thead>
			<tbody>
			{{#each attributes as |a|}}
			<tr class="{{#if a.overLimit}}over{{/if}} {{#if a.underMinimum}}under{{/if}}">
				<td>{{a.label}}</td>
				{{#if ../state.manual}}
				<td><input type="number" name="manualBase.{{a.key}}" value="{{a.manual}}" min="1" max="30"></td>
				{{else}}
				<td class="muted">{{#each a.rolls as |r|}}{{r}} {{/each}}</td><td>{{a.base}}</td>
				{{/if}}
				<td>{{a.rating}}</td><td>{{a.raceMod}}</td>
				<td class="strong">{{a.final}}{{#if a.overLimit}} (held to max){{/if}}{{#if a.underMinimum}} (below 5){{/if}}</td>
				<td class="muted">{{a.limit}}</td>
			</tr>
			{{/each}}
			</tbody>
		</table>

		<h3>Adjust {{ratio}}:1 <button type="button" data-action="addSwap">Add</button></h3>
		<p class="muted">Take {{ratio}} points to add 1. Social Class cannot be moved, and nothing may drop below 5.</p>
		{{#each swaps as |sw|}}
		<div class="swap-row">
			Raise <select name="swaps.{{sw.index}}.to">{{#each sw.toOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			by taking from
			{{#each sw.from as |f|}}
			<select name="swaps.{{sw.index}}.from.{{f.n}}">{{#each f.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			{{/each}}
			<button type="button" data-action="removeSwap" data-index="{{sw.index}}"><i class="fa-solid fa-trash"></i></button>
		</div>
		{{/each}}
		{{#each ratingIssues as |i|}}<p class="alarm">{{i}}</p>{{/each}}

		{{#if human.bonus}}
		<h3>Civilized Human</h3>
		<p class="muted">Add {{human.bonus}} points{{#if human.moves}} and move up to {{human.moves}}, one point at a time{{/if}}. Not Social Class.</p>
		<div class="swap-row">Add 1 to
			{{#each humanBonuses as |b|}}<select name="humanBonuses.{{b.n}}">{{#each b.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>{{/each}}
		</div>
		{{#each humanMoves as |m|}}
		<div class="swap-row">Move 1 from
			<select name="humanMoves.{{m.n}}.from">{{#each m.fromOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			to <select name="humanMoves.{{m.n}}.to">{{#each m.toOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
		</div>
		{{/each}}
		{{/if}}
	{{/if}}

	{{!-- @MARKER CLASS --}}
	{{#if isClass}}
		<h2>Class</h2>
		{{!-- Each class that this character cannot take says why in its own label, and the count
		      below says how many are open, so a low attribute reads as a rule rather than as a
		      broken list. Nothing is hidden or disabled: the requirement is a rule the player may
		      knowingly break with the override below. --}}
		<label class="row">Class
			<select name="className">{{#each classOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}} class="{{#if o.qualified}}qualified{{else}}unqualified{{/if}}">{{o.label}}</option>{{/each}}</select></label>
		{{#if classOfferedCount}}
		<p class="muted">{{classQualifiedCount}} of {{classOfferedCount}} classes are open to this
			character as rolled. The rest name what they are short of, and can still be taken with
			the override.</p>
		{{/if}}
		{{#if klass}}
		<div class="chargen-class">
			<h3>{{klass.name}} <span class="muted">{{klass.classType}}</span></h3>
			<p>{{klass.description}}</p>
			<p><label>Alignment</label> {{klass.alignment}} &nbsp; <label>Focus</label> {{klass.focus}}</p>
			<p><label>Attack</label> {{klass.attackSkillList}}</p>
			<p><label>Modifiers</label> {{klass.classMods}}</p>
			{{#if classIssues.length}}
				{{#each classIssues as |i|}}<p class="alarm">{{i}}</p>{{/each}}
				<label class="check"><input type="checkbox" name="override" {{#if state.override}}checked{{/if}}> Take it anyway (as his sheet's override)</label>
			{{else}}<p class="ok">Qualified.</p>{{/if}}
			{{#if nonClassed}}
			<label class="row">Attack chart (a GME picks one)
				<select name="chosenAttackSkill">{{#each attackSkillOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
			{{/if}}
		</div>
		{{/if}}
	{{/if}}

	{{!-- @MARKER SKILLS --}}
	{{#if isSkills}}
		<h2>Skills</h2>
		{{!-- @MARKER WHOLE CAREER
		      His Step 6 (HTML 40148-40153): the whole career, every title's class skills, CORE marked,
		      a box on each non-core row to give it up (his REMOVE), against the class slots Knowledge
		      gives, with his two CONVERT buttons as counts. Next is held while short, unless the Game
		      Master's override is ticked. The first title's skills are created now; the rest arrive at
		      their titles, and a row given up never does. --}}
		<h3>Class skills <span class="muted">class slots {{career.slots}}{{#if career.converted}} (was {{career.baseSlots}}){{/if}}
			/ needed {{career.needed}}{{#if career.short}} / <span class="alarm">short {{career.short}}</span>{{/if}}</span></h3>
		{{#if nonClassed}}<p class="muted">A GME has no class skills.</p>{{else}}
		{{#if career.has}}
		<p class="muted">The whole career, as his sheet plans it at creation: every skill takes a class slot now, the later
			titles' as well. Tick a skill that is not CORE to give it up; it is never granted. First-title skills are created
			with the character.</p>
		<div class="chargen-career">
		<table class="chargen-career-table">
			<thead><tr><th>Title</th><th>Skill</th><th>Core</th><th>Remove</th></tr></thead>
			<tbody>
			{{#each career.rows as |r|}}
			<tr class="{{#if r.checked}}removed{{/if}}">
				<td>{{r.title}}</td>
				<td>{{#if r.checked}}<s>{{r.name}}</s>{{else}}{{r.name}}{{/if}}{{#if r.replaces}} <span class="muted">(replaces {{r.replaces}})</span>{{/if}}</td>
				<td>{{#if r.core}}CORE{{/if}}</td>
				<td>{{#if r.removable}}<input type="checkbox" name="classRemovePick" value="{{r.key}}" {{#if r.checked}}checked{{/if}}>{{/if}}</td>
			</tr>
			{{/each}}
			</tbody>
		</table>
		</div>
		<div class="swap-row">Convert
			<input type="number" name="slotMoves.racialToClass" value="{{career.racialToClass}}" min="0" max="{{career.racialToClassMax}}">
			racial slot(s) to class slots (1 for 1), and
			<input type="number" name="slotMoves.socialToClass" value="{{career.socialToClass}}" min="0" max="{{career.socialToClassMax}}">
			pair(s) of social slots to class slots (2 for 1).</div>
		{{#if career.showOverride}}
		<label class="check"><input type="checkbox" name="classSlotOverride" {{#if state.classSlotOverride}}checked{{/if}}> Go on anyway (Game Master's call: fewer class slots than the career needs)</label>
		{{/if}}
		{{#if cannotCast}}<p class="muted">This race cannot cast, so it takes the no-casting alternatives.</p>{{/if}}

		{{!-- @MARKER CLASS CUSTOMIZATION
		      The Master's Manual's Customizing Classes (MM p.55), when the world allows it: up to three
		      skills swapped for others of the same type, never a CORE one, never one already in the class.
		      The incoming skill takes the replaced one's title. Its own minimum title and prerequisites
		      (MM pp.238-242) are not in the port's data, so they are given as advice. --}}
		{{#if classSwaps.show}}
		<h3>Customize the class <span class="muted">up to {{classSwaps.limit}} swaps, Master's Manual p.55</span>
			{{#if classSwaps.canAdd}}<button type="button" data-action="addClassSwap">Add</button>{{/if}}</h3>
		{{#each classSwaps.rows as |sw|}}
		<div class="swap-row">
			Replace <select name="classSwaps.{{sw.index}}.out">{{#each sw.outOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			with <select name="classSwaps.{{sw.index}}.in">{{#each sw.inOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			<button type="button" data-action="removeClassSwap" data-index="{{sw.index}}"><i class="fa-solid fa-trash"></i></button>
			{{#if sw.advice}}<p class="muted">{{sw.advice}}</p>{{/if}}
		</div>
		{{/each}}
		{{#each classSwaps.issues as |i|}}<p class="alarm">{{i}}</p>{{/each}}
		{{/if}}
		{{/if}}
		{{/if}}
		<h3>Racial skills <span class="muted">{{racialChosen}} of {{slots.racial}}</span></h3>
		<div class="pick-list">
			{{#each racialSkills as |s|}}<label><input type="checkbox" name="racialPick" value="{{s.name}}" {{#if s.checked}}checked{{/if}}> {{s.name}}{{#if s.bonus}} {{s.bonus}}{{/if}}</label>{{/each}}
		</div>
		<h3>Social skills <span class="muted">{{socialChosen}} of {{slots.social}}{{#if socialRaceName}}; modifiers for {{socialRaceName}}{{/if}}</span></h3>
		{{!-- @MARKER SOCIAL SKILLS
		      The class's own list first, as his Step 6 has it: Required flagged, then Recommend, in his
		      order; then every other social skill A-Z. Each skill is in one list only, and both share
		      name="socialPick". The first race's modifier beside each skill, as his recommended lists
		      show it. BLOCKED ones stay listed, marked, and the step refuses them -- his copy button
		      does the same. Both boxes are in the window's PARTS.scrollable, so a tick keeps the place. --}}
		{{#if classSocial.has}}
		<h4>From the {{classSocial.className}} list{{#if classSocial.hasUpTo}} &mdash; choose up to {{classSocial.upTo}}{{#if classSocial.requiredCount}} besides the Required{{/if}}{{/if}}
			{{#if classSocial.upToSource}}<span class="muted">({{classSocial.upToSource}})</span>{{/if}}</h4>
		<div class="pick-list chargen-social-class">
			{{#each classSocialSkills as |s|}}<label{{#if s.required}} class="required"{{/if}}><input type="checkbox" name="socialPick" value="{{s.name}}" {{#if s.checked}}checked{{/if}}> {{s.name}}{{#if s.required}} <strong>(Required)</strong>{{/if}}{{#if s.blocked}} <span class="alarm">BLOCKED</span>{{else}}{{#if s.mod}} {{s.mod}}{{/if}}{{/if}}</label>{{/each}}
		</div>
		<h4>Other social skills{{#if classSocial.hasUpTo}} <span class="muted">(these count toward the {{classSocial.upTo}} as well)</span>{{/if}}</h4>
		{{else}}
		{{#if classSocial.anyList}}<p class="muted">The {{classSocial.className}} may choose from any social skill{{#if classSocial.hasUpTo}}, up to {{classSocial.upTo}}{{#if classSocial.upToSource}} ({{classSocial.upToSource}}){{/if}}{{/if}}.</p>{{/if}}
		{{/if}}
		<div class="pick-list tall chargen-social-other">
			{{#each otherSocialSkills as |s|}}<label><input type="checkbox" name="socialPick" value="{{s.name}}" {{#if s.checked}}checked{{/if}}> {{s.name}}{{#if s.blocked}} <span class="alarm">BLOCKED</span>{{else}}{{#if s.mod}} {{s.mod}}{{/if}}{{/if}}</label>{{/each}}
		</div>
		{{#if classSocial.showOverride}}
		<label class="check"><input type="checkbox" name="socialOverride" {{#if state.socialOverride}}checked{{/if}}> Go on anyway (Game Master's call: a Required skill left out, or more than the class's count)</label>
		{{/if}}
		<p class="muted">Starting bonuses are worked out when the character is created, as on his sheet: a racial skill's dice count double, a class skill takes +30 if it is core, a social skill takes its race modifier, and skills lift one another (Mathematics gives Accounting +10%, Explorer gives Cartography +25%). The Review step lists them. Slots can be converted afterwards on the Skills tab.</p>
	{{/if}}

	{{!-- @MARKER DETAILS --}}
	{{#if isDetails}}
		<h2>Details</h2>
		{{!-- Rolled once when the race is known, and then it STANDS. There is no re-roll button
		      here, deliberately: "Michael's sheet had it hard coded to make that roll and stick
		      with it. For a reason" -- Ambidextrous is a large advantage in this system, and a
		      button that re-rolls until it appears is the same as choosing it. A Game Master who
		      wants it chosen outright can tick "Players may choose handedness", which is an honest
		      choice rather than a disguised one; only then does the dropdown, and the die beside
		      it, come back. --}}
		<label class="row">Handedness
			{{#if handednessSelectable}}
			<select name="handedness">{{#each handednessOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			<button type="button" data-action="rollHandedness"><i class="fa-solid fa-dice"></i> Roll</button>
			{{else}}
			<span class="rolled-value">{{#if state.handedness}}{{state.handedness}}{{else}}&mdash; choose a race first &mdash;{{/if}}</span>
			<span class="muted">rolled once, and it stands</span>
			{{/if}}</label>
		<label class="row">Age <input type="number" name="age" value="{{state.age}}">
			<button type="button" data-action="rollAge"><i class="fa-solid fa-dice"></i> Roll</button>
			{{#if ages}}<span class="muted">{{ages.startLow}}&ndash;{{ages.startHigh}}, maximum {{ages.maxAge}}</span>{{/if}}</label>
		{{!-- Height, frame and weight are rolled together, because his tables make them depend on
		      each other: the race gives a height band, the band gives inches, the race and the
		      character's Strength less Agility give a frame, and the frame with the inches gives a
		      weight. That is his own Apply Height/Frame button. --}}
		<label class="row">Height <input type="number" name="heightFeet" value="{{state.heightFeet}}"> ft
			<input type="number" name="heightInches" value="{{state.heightInches}}"> in
			<button type="button" data-action="rollPhysique"><i class="fa-solid fa-dice"></i> Roll height, frame &amp; weight</button></label>
		<label class="row">Weight <input type="number" name="weight" value="{{state.weight}}"> lb
			<span class="muted">(carrying capacity depends on it)</span></label>
		<label class="row">Frame <input type="text" name="frame" value="{{state.frame}}"></label>
		{{#if physique}}
		<p class="muted">{{physique.summary}}</p>
		{{/if}}
		{{!-- His tables say which colours a member of each race is found in, so they can be rolled
		      as well as picked. Fills only what is still blank, so a chosen colour survives. --}}
		{{#if hairChoices.length}}
		<p><button type="button" data-action="rollColours"><i class="fa-solid fa-dice"></i>
			Roll the ones left blank</button></p>
		{{/if}}
		<label class="row">Hair
			{{#if hairChoices.length}}
			<select name="hair">{{#each hairChoices as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			{{else}}<input type="text" name="hair" value="{{state.hair}}">{{/if}}</label>
		<label class="row">Eyes
			{{#if eyesChoices.length}}
			<select name="eyes">{{#each eyesChoices as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			{{else}}<input type="text" name="eyes" value="{{state.eyes}}">{{/if}}</label>
		<label class="row">Skin
			{{#if skinChoices.length}}
			<select name="skin">{{#each skinChoices as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			{{else}}<input type="text" name="skin" value="{{state.skin}}">{{/if}}</label>
		{{!-- @MARKER ALIGNMENT
		      His step 7: the class's lists only (module/alignment-rules.mjs), his description under each,
		      and his Alignmentless tick ("GM Discretion"), which writes N/A to both. --}}
		<h3>Alignment {{#if alignment.requirement}}<span class="muted">the class allows: {{alignment.requirement}}</span>{{/if}}</h3>
		<label class="check"><input type="checkbox" name="alignmentless" {{#if alignment.alignmentless}}checked{{/if}}> Alignmentless
			<span class="muted">(ignore alignment and play Alignmentless; GM discretion)</span></label>
		{{#unless alignment.alignmentless}}
		{{#if alignment.unknown}}<p class="alarm">The class's requirement is not one of his, so every alignment is offered.</p>{{/if}}
		{{#if alignment.empty}}<p class="alarm">The classes have no alignment in common.</p>{{/if}}
		{{#if alignment.special}}<p class="muted">{{alignment.special}}</p>{{/if}}
		<label class="row">Alignment
			<select name="alignment">{{#each alignment.options as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
		{{#if alignment.description}}<p class="muted chargen-alignment-description">{{alignment.description}}</p>{{/if}}
		<label class="row">Tendency
			<select name="tendencies">{{#each alignment.tendencyOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></label>
		{{#if alignment.tendencyDescription}}<p class="muted chargen-alignment-description">{{alignment.tendencyDescription}}</p>{{/if}}
		{{#if alignment.showOverride}}
		<label class="check"><input type="checkbox" name="override" {{#if state.override}}checked{{/if}}> Take it anyway (the class override: a GM's call)</label>
		{{/if}}
		{{/unless}}
		<h3>Languages <span class="muted">Intelligence allows {{languageAllowance.spoken}} spoken, {{languageAllowance.written}} written</span></h3>
		{{#each languages as |l|}}
		<div class="swap-row"><input type="text" name="languages.{{l.n}}.name" value="{{l.name}}">
			<label class="check"><input type="checkbox" name="languages.{{l.n}}.write" {{#if l.write}}checked{{/if}}> writes</label></div>
		{{/each}}
	{{/if}}

	{{!-- @MARKER EQUIPMENT --}}
	{{#if isEquipment}}
		<h2>Equipment</h2>
		{{!-- @MARKER STARTING MONEY
		      Rolled by itself when this step is first drawn, his setCoins -- see module/starting-money.mjs.
		      The fields stay editable because the book leaves the Game Master free to alter it (p.207);
		      the roll itself is in chat. With Gear by culture ticked the fields are not shown at all,
		      since that kit is taken instead of coins and anything typed here would be ignored. --}}
		<h3>Money</h3>
		{{#if moneyGearRace}}{{#unless moneyByCulture}}<p class="muted">His sheet gives a {{moneyGearRace}} wilderness gear
			instead of coins: tick Gear by culture below to take it.</p>{{/unless}}{{/if}}
		{{#if moneyFairyNote}}<p class="muted">{{moneyFairyNote}}</p>{{/if}}
		{{#if moneyByCulture}}
		<p class="muted">Gear by culture is ticked below, and it is taken <em>instead of</em> starting coins:
			this character starts with none. Untick it to have the coins back.</p>
		{{else}}
		<div class="swap-row">
			<label>Copper <input type="number" name="wealth.copper" value="{{state.wealth.copper}}"></label>
			<label>Silver <input type="number" name="wealth.silver" value="{{state.wealth.silver}}"></label>
			<label>Gold <input type="number" name="wealth.gold" value="{{state.wealth.gold}}"></label>
			<label>Platinum <input type="number" name="wealth.platinum" value="{{state.wealth.platinum}}"></label>
		</div>
		{{#if startingMoney}}<p class="muted">{{startingMoney.summary}}</p>{{/if}}
		{{/if}}

		{{!-- @MARKER STARTING KIT
		      His three optional ways of giving a character its gear, each its own tick and all three
		      off unless asked for -- as on his own sheet. A Game Master who has not asked should not
		      find equipment appearing on their players. Any combination may be on at once, and
		      anything two of them bring is carried twice rather than listed twice. --}}
		<h3>Starting kit <span class="muted">optional &mdash; ask your Game Master</span></h3>
		<label class="row check"><input type="checkbox" name="startingKit.byCulture" {{#if state.startingKit.byCulture}}checked{{/if}}>
			Gear by culture &mdash; the wilderness kit his tables give this race, <em>instead of</em> starting coins</label>
		<label class="row check"><input type="checkbox" name="startingKit.byStatus" {{#if state.startingKit.byStatus}}checked{{/if}}>
			Clothing by status &mdash; free clothing for this race at this social class</label>
		{{#if state.startingKit.byStatus}}
		<label class="row">Style
			<select name="clothingStyle">{{#each clothingStyles as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			<span class="muted">only some races’ wardrobes vary by style</span></label>
		{{/if}}
		<label class="row check"><input type="checkbox" name="startingKit.bySkills" {{#if state.startingKit.bySkills}}checked{{/if}}>
			Tools by skill &mdash; each social skill taken brings its own equipment</label>
		{{#if startingKitPreview.length}}
		<p class="muted">This would bring: {{#each startingKitPreview as |i|}}<span class="race-chip">{{i}}</span>{{/each}}</p>
		{{/if}}

		{{!-- @MARKER SHOP
		      His ADD/BUY ITEMS panel, at his prices, paid his way -- see module/shop-rules.mjs. Nothing is
		      paid until the character is created: the list is priced afresh against the purse above every
		      time this is drawn, so a line the purse can no longer cover is marked, and Next waits until
		      it is removed or cut down. Everything bought is carried; armour is put on at creation. --}}
		<h3>Shop <span class="muted">{{shop.priceLevelLabel}} prices, the Game Master&rsquo;s to set</span></h3>
		{{#if shop.gaps}}<p class="muted"><i class="fa-solid fa-circle-info"></i> {{shop.gaps}}</p>{{/if}}
		{{#if shop.byCulture}}
		<p class="muted">Gear by culture is taken <em>instead of</em> starting coins, so there is nothing to buy with.
			{{#if shop.keptCount}}The shopping list is kept, and comes back if it is unticked.{{/if}}</p>
		{{else}}
		<p>Purse {{shop.purse}}. After the list: <strong>{{shop.purseAfter}}</strong>. Spent {{shop.spent}}.</p>
		{{#if shop.lines.length}}
		<table class="chargen-shop-list">
			<thead><tr><th>Bought</th><th>No#</th>{{#if shop.isGM}}<th>Price level</th>{{/if}}<th>Each</th><th>Total</th><th>Weight</th><th></th></tr></thead>
			<tbody>
			{{#each shop.lines as |l|}}
			<tr class="{{#unless l.ok}}unaffordable{{/unless}}">
				<td>{{l.label}}{{#unless l.ok}}<div class="alarm">{{l.reason}}</div>{{/unless}}{{#if l.issue}}<div class="muted">{{l.issue}}</div>{{/if}}</td>
				<td><input type="number" name="purchases.{{l.index}}.count" value="{{l.count}}" min="0"></td>
				{{#if ../shop.isGM}}<td><select name="purchases.{{l.index}}.level">{{#each l.levelOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select></td>{{/if}}
				<td>{{l.unitPrice}}</td><td>{{l.total}}</td><td class="muted">{{l.weightText}}</td>
				<td><button type="button" data-action="removePurchase" data-index="{{l.index}}" title="Take it off the list"><i class="fa-solid fa-trash"></i></button></td>
			</tr>
			{{/each}}
			</tbody>
		</table>
		{{/if}}
		{{!-- @MARKER LOAD -- shown, never refused: his add_item does not look at encumbrance. --}}
		<p class="muted">{{#if shop.load}}Carrying {{shop.load.carried}} lb of {{shop.load.maxLoad}}:
			<span class="{{#if shop.load.over}}alarm{{/if}}">{{shop.load.status}}{{#if shop.load.penalty}}, {{shop.load.penalty}}{{/if}}</span>.
			{{else}}Roll height and weight on the Details step to see what this character can carry.{{/if}}</p>

		<div class="swap-row chargen-shop-filter">
			<select name="shop.type">{{#each shop.typeOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			<select name="shop.subtype">{{#each shop.subtypeOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{o.label}}</option>{{/each}}</select>
			<input type="text" name="shop.search" value="{{shop.search}}" placeholder="Search by name">
			<button type="button" data-action="searchShop" title="Search"><i class="fa-solid fa-magnifying-glass"></i></button>
			<label>No# <input type="number" name="shop.count" value="{{shop.count}}" min="1"></label>
		</div>
		<table class="chargen-shop-offers">
			<tbody>
			{{#each shop.offers as |o|}}
			<tr class="{{#unless o.affordable}}unaffordable{{/unless}}">
				<td>{{o.label}}{{#if o.homebrew}} <span class="muted">(Game Master&rsquo;s)</span>{{/if}}</td>
				<td title="{{o.prices}}">{{o.price}}{{#if o.priceIssue}} <i class="fa-solid fa-circle-info" title="{{o.priceIssue}}"></i>{{/if}}</td>
				<td class="muted">{{o.weight}}</td>
				<td><button type="button" data-action="buyOffer" data-offer="{{o.key}}">Buy</button></td>
			</tr>
			{{else}}
			<tr><td class="muted">Nothing here matches.</td></tr>
			{{/each}}
			</tbody>
		</table>
		{{#if shop.offerMore}}<p class="muted">{{shop.offerMore}} more &mdash; choose a kind or search to narrow the list.</p>{{/if}}
		{{/if}}
	{{/if}}

	{{!-- @MARKER REVIEW --}}
	{{#if isReview}}
		<h2>{{#if state.name}}{{state.name}}{{else}}New Character{{/if}}</h2>
		<p>{{raceName}} {{#if klass}}{{klass.name}}{{/if}}, title {{review.title}}. {{typeLabel}} character.</p>
		<p>Alignment: {{#if review.alignment}}{{review.alignment}}{{else}}none{{/if}}{{#if review.tendencies}}; tendency {{review.tendencies}}{{/if}}</p>
		<p>Money: {{#if review.money}}{{review.money}}{{else}}none{{/if}}</p>
		{{#if review.bought.length}}
		<p>Bought: {{#each review.bought as |b|}}<span class="race-chip">{{b}}</span>{{/each}} <span class="muted">&mdash; spent {{review.spent}}</span></p>
		{{/if}}
		<table class="chargen-attributes compact"><tbody>
			{{#each attributes as |a|}}<tr><td>{{a.label}}</td><td class="strong">{{a.final}}</td></tr>{{/each}}
		</tbody></table>
		<h3>Items</h3>
		<p>{{#each review.items as |it|}}<span class="race-chip">{{it.name}}{{#if it.quantity}} &times;{{it.quantity}}{{/if}}{{#if it.category}} ({{it.category}}){{/if}}</span>{{/each}}</p>
		{{!-- @MARKER RACE AND CROSS-SKILL MODIFIERS -- each skill's fixed bonus and what it is made
		      of; the dice are rolled on Create and are not part of it. --}}
		{{#if review.skillBonuses.length}}<h3>Skill bonuses <span class="muted">besides the dice</span></h3>
		{{#each review.skillBonuses as |b|}}<p><strong>{{b.name}}</strong> <span class="muted">({{b.category}})</span> {{b.total}}: {{b.summary}}</p>{{/each}}{{/if}}
		{{#if review.issues.length}}<h3>To note</h3>{{#each review.issues as |i|}}<p class="alarm">{{i}}</p>{{/each}}{{/if}}
		{{!-- @MARKER STARTING LORE -- his own tick, in his own words, on his last step. --}}
		<h3>Lore</h3>
		<label class="row check"><input type="checkbox" name="randomLore" {{#if state.randomLore}}checked{{/if}}>
			Provide random lore for starting spells, all relevant skills, and related consumables.
			<span class="muted">If unchecked, the Game Master can provide it after, from the Magic &amp; Lore tab.</span></label>
	{{/if}}

	</section>

	<footer class="chargen-footer">
		{{#if blocker}}<span class="alarm">{{blocker}}</span>{{/if}}
		<button type="button" data-action="previousStep" {{#if isFirst}}disabled{{/if}}><i class="fa-solid fa-arrow-left"></i> Back</button>
		{{#if isLast}}
		<button type="button" data-action="createCharacter" class="primary"><i class="fa-solid fa-user-plus"></i> Create character</button>
		{{else}}
		<button type="button" data-action="nextStep">Next <i class="fa-solid fa-arrow-right"></i></button>
		{{/if}}
	</footer>
</div>

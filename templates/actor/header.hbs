{{!-- Character sheet header: identity, and the four characteristics that summarise a being. --}}
<header class="imagine-header">

	{{!-- data-action="editImage" is what opens the file picker on an ApplicationV2 sheet; data-edit alone
	      only ever worked on the old sheets (bug sweep 2026-09-23). --}}
	<img class="portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}">

	<div class="identity">
		<input class="charname" type="text" name="name" value="{{actor.name}}" placeholder="Name">

		{{!-- A dual-classed character advances each class separately, so each carries its own title
		      and gets its own row. One class reads exactly as it always did. --}}
		<div class="identity-line">
			{{!-- Two race items make a Half Race, named "first|second" as his sheet names one. --}}
			<span class="field"><label>{{#if system.identity.isHalfRace}}Half Race{{else}}Race{{/if}}</label><span class="readout">{{#if system.identity.raceName}}{{system.identity.raceName}}{{else}}&mdash;{{/if}}</span></span>
			{{#if system.identity.isDualClass}}
			<span class="field"><label>Classes</label><span class="readout">{{system.identity.classNames}}</span></span>
			{{else}}
			<span class="field"><label>Class</label><span class="readout">{{#if system.identity.className}}{{system.identity.className}}{{else}}&mdash;{{/if}}</span></span>
			<span class="field"><label>Title</label><span class="readout">{{system.identity.title}} {{system.identity.titleName}}</span></span>
			{{!-- What stops this class -- checkClassQualification against the character's own final
			      attributes, the same check the generator's class dropdown makes. Shortfall only,
			      in this tight space; the full sentence is the tooltip. A character taken with the
			      override says so here rather than looking like any other. See
			      docs/sonnet/2026-09-20-first-install-bugs.md item 8. --}}
			{{#with (lookup system.identity.classes 0) as |c|}}
			{{#unless c.qualified}}
			<span class="field class-qualification-issue" title="{{c.qualificationFull}}">{{c.qualificationShort}}</span>
			{{/unless}}
			{{/with}}
			{{/if}}
		</div>

		{{#if system.identity.raceWarning}}
		<div class="identity-line dual-class-issues"><span class="alarm">{{system.identity.raceWarning}}</span></div>
		{{/if}}
		{{!-- Reported, never refused: his sheet lets a barred class be overridden, and the book makes
		      a mixed race the Game Master's call. --}}
		{{#if system.identity.raceIssues.length}}
		<div class="identity-line dual-class-issues">
			{{#each system.identity.raceIssues as |issue|}}<span class="alarm">{{issue}}</span>{{/each}}
		</div>
		{{/if}}

		{{#if system.identity.isDualClass}}
		<div class="identity-line class-titles">
			{{#each system.identity.classes as |c|}}
			<span class="field"><label>{{c.name}}</label>
				<span class="readout">
					<button type="button" class="title-step" data-action="stepClassTitle"
						data-item-id="{{c.id}}" data-step="-1" data-tooltip="Back a title">&minus;</button>
					{{c.title}}
					<button type="button" class="title-step" data-action="stepClassTitle"
						data-item-id="{{c.id}}" data-step="1" data-tooltip="On a title">+</button>
					{{c.titleName}}</span>
				{{!-- Same qualification check as the single-class field above. --}}
				{{#unless c.qualified}}
				<span class="class-qualification-issue" title="{{c.qualificationFull}}">{{c.qualificationShort}}</span>
				{{/unless}}
			</span>
			{{/each}}
		</div>
		{{#if system.identity.dualClassIssues.length}}
		{{!-- Reported, never refused: the book makes dual classing the Game Master's call. --}}
		<div class="identity-line dual-class-issues">
			{{#each system.identity.dualClassIssues as |issue|}}<span class="alarm">{{issue}}</span>{{/each}}
		</div>
		{{/if}}
		{{/if}}

		<div class="identity-line">
			<span class="field"><label>Alignment</label>
				<input type="text" name="system.identity.alignment" value="{{system.identity.alignment}}"
					title="{{system.identity.alignment}}"></span>
			<span class="field"><label>Exp</label>
				<input type="number" name="system.identity.exp" value="{{system.identity.exp}}"></span>
			<span class="field"><label>Goal</label>
				<input type="number" name="system.identity.goal" value="{{system.identity.goal}}"></span>
			{{!-- Experience is typed in here or added through the window; the window is the one
			      that applies his cap, his refusals and the Arch Mortal line. --}}
			<span class="field"><label>Next goal</label>
				<span class="readout">{{system.identity.nextGoalExp}}</span></span>
			<button type="button" class="level-up-open {{#if system.identity.levelUpPending}}alarm{{/if}}"
				data-action="openLevelUp">{{#if system.identity.levelUpPending}}Level up waiting{{else}}Experience &amp; levels{{/if}}</button>
		</div>
	</div>

	{{!-- Endurance, Perception, Affinity and Fortune: one per attribute category. --}}
	<div class="characteristics">
		<div class="char-box">
			<label>Endurance</label>
			<span class="value">{{system.characteristics.endurance.value}}</span>
			<span class="sub">Shock {{system.body.shock}}</span>
		</div>
		<div class="char-box">
			<label>Perception</label>
			<span class="value">{{system.characteristics.perception.value}}%</span>
			<button type="button" class="char-roll" data-action="rollCharacteristic" data-characteristic="perception" data-tooltip="Roll Perception">Roll</button>
			<button type="button" class="char-roll" data-action="rollCharacteristic" data-characteristic="perception" data-double="true" data-tooltip="Roll at double Perception">Dbl</button>
		</div>
		<div class="char-box">
			<label>Affinity</label>
			<span class="value">{{system.characteristics.affinity.value}}%</span>
			<button type="button" class="char-roll" data-action="rollCharacteristic" data-characteristic="affinity" data-tooltip="Roll Affinity">Roll</button>
		</div>
		<div class="char-box">
			<label>Fortune</label>
			<span class="value">{{system.characteristics.fortune.value}}%</span>
			<button type="button" class="char-roll" data-action="rollCharacteristic" data-characteristic="fortune" data-tooltip="Roll Fortune">Roll</button>
		</div>
	</div>
</header>

{{!--
	Equipment tab. Weapons, armour and general gear together, since encumbrance counts them
	together and what matters most is where a thing is: worn and carried weight counts against
	the character, stowed on a mount or left in a stash does not.
--}}
<section class="tab imagine-equipment{{#if tab.active}} active{{/if}}" data-tab="equipment" data-group="primary">

	<div class="encumbrance-bar">
		<span class="status">{{system.encumbrance.status}}</span>
		<span class="muted">{{system.encumbrance.carried}} / {{system.encumbrance.maxLoad}} lb carried</span>
	</div>

	{{!-- @MARKER WEALTH
	      His Loose Equipment money panel: Wealth(in Gold), the coins, gems, jewelry and special, and
	      his three update rows. The update inputs have no name on purpose -- they are read by the
	      changeWealth action and never written to the character. The same fields can still be edited
	      directly on the Description tab. module/wealth-rules.mjs. --}}
	<div class="wealth-panel">
		<div class="wealth-line">
			<span><strong>Wealth (in Gold):</strong> {{wealthPanel.inGold}}</span>
			<span><strong>Platinum:</strong> {{system.wealth.platinum}}</span>
			<span><strong>Gold:</strong> {{system.wealth.gold}}</span>
			<span><strong>Silver:</strong> {{system.wealth.silver}}</span>
			<span><strong>Copper:</strong> {{system.wealth.copper}}</span>
		</div>
		<div class="wealth-line"><strong>Gems:</strong> {{#each wealthPanel.gems as |g|}}<span class="race-chip">{{g}}</span>{{else}}<span class="muted">none</span>{{/each}}</div>
		<div class="wealth-line"><strong>Jewelry/Other:</strong> {{#each wealthPanel.jewelry as |j|}}<span class="race-chip">{{j}}</span>{{else}}<span class="muted">none</span>{{/each}}</div>
		<div class="wealth-line"><strong>Special:</strong> {{#if system.wealth.special}}{{system.wealth.special}}{{else}}<span class="muted">none</span>{{/if}}</div>

		<div class="wealth-update">
			<strong>Update Coins:</strong> Type
			<select data-wealth="type"><option value=""></option>{{#each wealthPanel.coinTypes as |c|}}<option value="{{c}}">{{c}}</option>{{/each}}</select>
			No. of Coins <input type="number" min="1" data-wealth="count">
			<button type="button" data-action="changeWealth" data-kind="coins" data-mode="add">Add</button>
			<button type="button" data-action="changeWealth" data-kind="coins" data-mode="subtract">Subtract</button>
		</div>
		<div class="wealth-update">
			<strong>Update Gems:</strong> Type
			<select data-wealth="name"><option value=""></option>{{#each wealthPanel.gemTypes as |g|}}<option value="{{g}}">{{g}}</option>{{/each}}</select>
			No. of Gems <input type="number" min="1" data-wealth="count">
			Value/Each <input type="number" min="1" data-wealth="value">
			<button type="button" data-action="changeWealth" data-kind="gems" data-mode="add">Add</button>
			<button type="button" data-action="changeWealth" data-kind="gems" data-mode="subtract">Subtract</button>
		</div>
		<div class="wealth-update">
			<strong>Update Jewelry/Other:</strong> Name
			<input type="text" maxlength="30" data-wealth="name">
			No. <input type="number" min="1" data-wealth="count">
			Value/Each <input type="number" min="1" data-wealth="value">
			<button type="button" data-action="changeWealth" data-kind="jewelry" data-mode="add">Add</button>
			<button type="button" data-action="changeWealth" data-kind="jewelry" data-mode="subtract">Subtract</button>
		</div>
	</div>

	{{!-- Adding gear by hand, for something no compendium holds. Dragging from a compendium still
	      works and is the better route for anything the system already knows. --}}
	<div class="gear-add">
		<button type="button" data-action="createGear" data-type="equipment">Add equipment</button>
		<button type="button" data-action="createGear" data-type="weapon">Add weapon</button>
		<button type="button" data-action="createGear" data-type="armor">Add armour</button>
	</div>

	{{!-- Kitting out in one go, and the exact reverse of it. Equip Best Armour wears the strongest
	      legal set the character owns (layering rules, module/equip-rules.mjs); Take Everything Off
	      unequips the lot back to carried. Neither destroys anything -- an item that really is to go
	      has its own delete on its row. --}}
	<div class="gear-add">
		<button type="button" data-action="equipBestArmor"
			data-tooltip="Wear the strongest armour carried that layers legally; take off the rest">Equip best armour</button>
		<button type="button" data-action="removeAllArms"
			data-tooltip="Unequip every weapon and piece of armour, shields included. Nothing is deleted &mdash; it all stays carried">Take everything off</button>
	</div>

	{{#if gear.length}}
	<table class="gear-table">
		<thead>
			<tr>
				<th class="col-name">Item</th>
				<th class="col-num">Type</th>
				<th class="col-num">Qty</th>
				<th class="col-num">Weight</th>
				<th class="col-num">Location</th>
				<th class="col-row-actions"></th>
			</tr>
		</thead>
		<tbody>
			{{#each gear as |item|}}
			<tr class="{{#if (eq item.system.available false)}}unavailable{{/if}}"
			    {{#if (eq item.system.available false)}}data-tooltip="{{item.system.unavailableReason}}"{{/if}}>
				<td class="col-name">{{item.name}}{{#if (eq item.system.available false)}}
					<i class="fa-solid fa-ban unavailable-mark" aria-label="Unavailable: {{item.system.unavailableReason}}"></i>{{/if}}</td>
				<td class="col-num muted">{{item.type}}</td>
				<td class="col-num">{{item.system.quantity}}</td>
				<td class="col-num muted">{{item.system.weight}}</td>
				<td class="col-num muted">{{item.system.location}}</td>
				<td class="col-row-actions">
					{{#if (eq item.type "weapon")}}<button type="button" class="row-button" data-action="openWeaponMods"
						data-item-id="{{item.id}}" data-tooltip="Weapon mods: bless it, or customize it"><i class="fa-solid fa-wand-magic-sparkles"></i></button>{{/if}}
					<button type="button" class="row-button" data-action="openItem"
						data-item-id="{{item.id}}" data-tooltip="Edit this item">&#9998;</button>
					<button type="button" class="row-button" data-action="deleteItem"
						data-item-id="{{item.id}}" data-tooltip="Remove from this character">&times;</button>
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>
	{{else}}
	<p class="empty">Nothing carried. Drag items here from a compendium, or add one above.</p>
	{{/if}}
</section>

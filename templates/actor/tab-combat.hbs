{{!--
	Combat tab. One root element, as the framework requires of every PART.

	Three things a player needs mid-fight: the standing numbers (attack skill, initiative,
	defence, weapon speed), the weapons they can swing, and the state of their body -- every
	area's Endurance, the wounds on it and the armour covering it.
--}}
<section class="tab imagine-combat{{#if tab.active}} active{{/if}}" data-tab="combat" data-group="primary">

	<div class="combat-stats">
		<div class="char-box"><label>Attack Skill</label><span class="value small">{{system.combat.attackSkill}}</span>
			{{!-- A GME earns no chart by title; the player picks it, as on his sheet. --}}
			{{#if system.identity.isNonClassed}}
			<select name="system.combat.chosenAttackSkill" class="gme-attack-choice">
				{{#each chosenAttackSkillChoices as |c|}}<option value="{{c.value}}" {{#if c.selected}}selected{{/if}}>{{c.label}}</option>{{/each}}
			</select>
			{{/if}}
			{{#if system.combat.loreAttackSkill}}
			<span class="sub">Lore: {{system.combat.loreAttackSkill}}</span>
			{{/if}}</div>
		<div class="char-box"><label>Initiative</label>
			<span class="value">d10 {{#if (gte system.combat.initiativeMod 0)}}+{{/if}}{{system.combat.initiativeMod}}</span>
			<span class="sub">lower acts first</span></div>
		{{!-- Includes the Situation Mods' own defence; "No Defense" takes it away altogether. --}}
		<div class="char-box"><label>Defence</label>
			{{#if system.combat.noDefense}}<span class="value alarm">None</span>
			<span class="sub">No Defense, from Situation Mods</span>
			{{else}}<span class="value">{{#if (gt system.combat.defensiveAdjust 0)}}+{{/if}}{{system.combat.defensiveAdjust}}</span>
			<span class="sub">to attackers' rolls</span>{{/if}}</div>
		<div class="char-box"><label>Weapon Speed</label>
			<span class="value">{{#if (gt system.combat.weaponSpeedMod 0)}}+{{/if}}{{system.combat.weaponSpeedMod}}</span>
			<span class="sub">seconds per swing</span></div>
		{{!-- 5 of the round's 10 seconds by default, more for Second Weapon Lore, all 10 for
		      Ambidextrous. The allowance; what a round has spent of it is on the round clock in the
		      combat tracker and the Mr. Initiative window. --}}
		<div class="char-box"><label>Off-Hand Seconds</label>
			<span class="value">{{system.combat.offhandSecondsCap}}</span>
			<span class="sub">{{#if (eq system.physical.handedness "Ambidextrous")}}both hands, all ten{{else}}of the round{{/if}}</span></div>
		{{!-- His tmp_speed_seconds: extra seconds every round from a Speed potion, spell, rune or
		      glyph, entered by hand until those effects are built. Each splits one of the round's
		      first seconds in two, and a sped combatant acts first (module/combat/round-rules.mjs). --}}
		<div class="char-box"><label>Speed Seconds</label>
			<span class="value"><input type="number" class="speed-input" min="0" max="10"
				name="system.combat.speedSeconds" value="{{system.combat.speedSeconds}}"></span>
			<span class="sub">extra each round</span></div>
		<div class="char-box"><label>Shock</label>
			<span class="value {{#if system.body.inShock}}alarm{{/if}}">{{system.body.totalWounds}} / {{system.body.shock}}</span>
			<span class="sub">{{#if system.body.inShock}}IN SHOCK{{else}}total wounds{{/if}}</span></div>
		{{!-- A SIGNED modifier on incoming damage, applied before armour sees the blow. His own
		      note reads "reduces or adds to all incoming damage (-/+)", so a negative number is
		      a tougher target. --}}
		<div class="char-box"><label>Pain Threshold</label>
			<span class="value"><input type="number" class="pain-input"
				name="system.combat.painThreshold" value="{{system.combat.painThreshold}}"></span>
			<span class="sub">to incoming damage (&minus;/+)</span></div>
		{{!-- A pool, not a per-blow reduction: it takes what it can off a blow after armour and
		      hide, and is spent by the same amount, so it wears out. --}}
		<div class="char-box"><label>Absorption</label>
			<span class="value"><input type="number" class="pain-input" min="0"
				name="system.combat.damageAbsorb" value="{{system.combat.damageAbsorb}}"></span>
			<span class="sub">pool, spent as used</span></div>
	</div>

	{{!-- His "SITUATION MODS" bar: what every attack of one kind reads until it is cleared, and the
	      button that opens the melee and missile panels. --}}
	<div class="situation-bar">
		<strong>Situation Mods:</strong>
		{{#if situationLine}}<span class="situation-line">{{situationLine}}</span>{{else}}<span class="muted">none set</span>{{/if}}
		<button type="button" data-action="openSituation"><i class="fa-solid fa-sliders"></i> Melee / Missile Mods</button>
		{{#if situationLine}}<button type="button" data-action="clearSituation" data-tooltip="Clear all modifiers"><i class="fa-solid fa-eraser"></i></button>{{/if}}
	</div>

	{{!-- Everything here comes off a blow BEFORE any worn armour blocks it, in his order. Each is
	      the best of what worn magic items grant and the Game Master's modifier, not a sum, and
	      the items that grant them belong to the deferred magic subsystems -- so for now they are
	      entered here by hand. --}}

	{{!-- Weapon and Missile Lore. Holding the lore at all comes from the class and the title, so
	      it is derived; these lists only name the weapons singled out for the larger bonus. His
	      sheet keeps each as one comma-separated string of simplified names. --}}
	{{#if lore.show}}
	<h3 class="section-head">Lore <span class="muted">{{lore.label}}</span></h3>
	<div class="lore-lists">
		{{#if lore.hasWeapon}}
		<label>Weapons specifically lored
			<input type="text" name="system.combat.weaponLoreList" value="{{lore.weaponText}}"
				placeholder="Bastard Sword, Dagger"></label>
		{{/if}}
		{{#if lore.hasMissile}}
		<label>Missiles specifically lored
			<input type="text" name="system.combat.missileLoreList" value="{{lore.missileText}}"
				placeholder="Long Bow"></label>
		{{/if}}
		{{!-- Projectile Lore names the AMMUNITION, not the launcher: an Arrow, not the bow. --}}
		{{#if lore.hasProjectile}}
		<label>Projectiles specifically lored
			<input type="text" name="system.combat.projectileLoreList" value="{{lore.projectileText}}"
				placeholder="Arrow(Long Bow/Normal)"></label>
		{{/if}}

		{{!-- The two multi-missile skills are learned one launcher/missile pair at a time, so an
		      entry here is what makes the skill apply at all rather than naming a larger bonus.
		      "Thrown" is the launcher for a weapon thrown from the hand. --}}
		{{#if lore.hasMultiKnow}}
		<label>Multiple missile combinations known
			<input type="text" name="system.combat.multiMissileKnowList" value="{{lore.multiKnowText}}"
				placeholder="Long Bow/Arrow, Thrown/Dagger">
			<span class="muted">{{lore.multiKnowChance}}% &mdash; {{lore.multiKnowLevels}} level(s), each worth
			1 to hit and 2 damage off the penalty</span></label>
		{{/if}}
		{{#if lore.hasMultiLore}}
		<label>Multiple missile combinations lored
			<input type="text" name="system.combat.multiMissileLoreList" value="{{lore.multiLoreText}}"
				placeholder="Long Bow/Arrow">
			<span class="muted">removes the penalty entirely for these</span></label>
		{{/if}}

		{{!-- Second Weapon Knowledge and Lore are held weapon by weapon, one more for every title
		      held in the discipline. A weapon fights off-handed without penalty (Lore) or with
		      the penalty bought down (Knowledge) only when it is named here. --}}
		{{#if lore.hasSecondKnow}}
		<label>Second Weapon Knowledge in
			<input type="text" name="system.combat.secondWeaponKnowList" value="{{lore.secondKnowText}}"
				placeholder="Dagger, Short Sword">
			<span class="muted">{{lore.secondKnowChance}}% &mdash; {{lore.secondKnowLevels}} level(s) off the off-hand
			penalty; {{lore.secondKnowSlots}} more weapon(s) may be named</span></label>
		{{/if}}
		{{#if lore.hasSecondLore}}
		<label>Second Weapon Lore in
			<input type="text" name="system.combat.secondWeaponLoreList" value="{{lore.secondLoreText}}"
				placeholder="Dagger">
			<span class="muted">no off-hand penalty for these; {{lore.secondLoreSlots}} more weapon(s) may be named</span></label>
		{{/if}}
	</div>
	{{/if}}
	<h3 class="section-head">Magical Protection <span class="muted">taken off before armour</span></h3>
	<div class="combat-stats magic-armour">
		<div class="char-box"><label>Spiritual</label>
			<span class="value"><input type="number" class="pain-input" min="0"
				name="system.combat.spiritArmor" value="{{system.combat.spiritArmor}}"></span></div>
		<div class="char-box"><label>Force</label>
			<span class="value"><input type="number" class="pain-input" min="0"
				name="system.combat.forceArmor" value="{{system.combat.forceArmor}}"></span></div>
		<div class="char-box"><label>Outer Kinetic</label>
			<span class="value"><input type="number" class="pain-input" min="0"
				name="system.combat.outerKinetic" value="{{system.combat.outerKinetic}}"></span></div>
		<div class="char-box"><label>Magic Shield</label>
			<span class="value"><input type="number" class="pain-input" min="0"
				name="system.combat.magicShield" value="{{system.combat.magicShield}}"></span>
			<span class="sub">not against bypass</span></div>
		<div class="char-box"><label>Invulnerable</label>
			<span class="value"><input type="checkbox" name="system.combat.invulnerable"
				{{#if system.combat.invulnerable}}checked{{/if}}></span>
			<span class="sub">scales by the weapon's plus</span></div>
	</div>

	<h3 class="section-head">Weapons</h3>
	{{#if weapons.length}}
	<table class="weapon-table">
		<thead>
			<tr>
				<th class="col-name">Weapon</th>
				<th class="col-num">Damage</th>
				<th class="col-num">Speed</th>
				<th class="col-hand">Hand</th>
				<th>Attack</th>
			</tr>
		</thead>
		<tbody>
			{{#each weapons as |w|}}
			<tr>
				<td class="col-name">{{#if w.displayName}}{{w.displayName}}{{else}}{{w.name}}{{/if}}{{#unless w.equipped}} <span class="muted">(carried)</span>{{/unless}}
					{{#if w.lore}} <span class="lore-tag" data-tooltip="Attack +{{w.lore.attack}}, damage +{{w.lore.damage}}, speed {{w.lore.speed}}, skills +{{w.lore.skills}}%">{{#if w.lore.specific}}Lore{{else}}lore{{/if}}</span>{{/if}}
					{{!-- What has been done to it, for now and for good, and the window to do more. --}}
					{{#if w.customTags.length}} <span class="weapon-custom-tags muted">{{#each w.customTags as |t|}}{{t}}{{#unless @last}} &middot; {{/unless}}{{/each}}</span>{{/if}}
					<button type="button" class="row-button" data-action="openWeaponMods" data-item-id="{{w.id}}"
						data-tooltip="Weapon mods: bless it, or customize it as his panel does"><i class="fa-solid fa-wand-magic-sparkles"></i></button></td>
				<td class="col-num" {{#if w.listingTip}}data-tooltip="{{w.listingTip}}"{{/if}}>{{w.damage}}</td>
				<td class="col-num">{{w.speed}}{{#if w.reload}} <span class="muted">/ reload {{w.reload}}</span>{{/if}}</td>
				{{!-- Which hand it is in. Off-handedness is derived from this against the
				      character's handedness below, so an Ambidextrous character never shows the
				      off-hand marker however a weapon is tagged. --}}
				<td class="col-hand">
					<span class="hand-pick">
						<button type="button" class="{{#if (eq w.hand "left")}}on{{/if}}"
							data-action="setWeaponHand" data-item-id="{{w.id}}" data-hand="left"
							data-tooltip="Left hand">L</button>
						<button type="button" class="{{#if (eq w.hand "right")}}on{{/if}}"
							data-action="setWeaponHand" data-item-id="{{w.id}}" data-hand="right"
							data-tooltip="Right hand">R</button>
						<button type="button" class="{{#if (eq w.hand "both")}}on{{/if}}"
							data-action="setWeaponHand" data-item-id="{{w.id}}" data-hand="both"
							data-tooltip="Both hands - doubles a Strength damage bonus">2H</button>
					</span>
					{{!-- The tier is worked out from the character's Second Weapon lists, the same way
					      the attack works it out, so what the tag says is what the roll will use. --}}
					{{#if w.offhand}} <span class="offhand-tag" data-tooltip="{{w.offhandTip}}">off{{#if (eq w.offhandTier "knowledge")}} &middot; know{{else if (eq w.offhandTier "lore")}} &middot; lore{{/if}}</span>{{/if}}
				</td>
				<td>
					{{#if w.modes.length}}
					<button type="button" data-action="rollWeaponAttack" data-item-id="{{w.id}}">
						<i class="fa-solid fa-dice-d20"></i> Attack</button>
					<span class="muted mode-list">{{#each w.modes as |m|}}{{m.mode}} {{#if (gte m.mod 0)}}+{{/if}}{{m.mod}}{{#unless @last}}, {{/unless}}{{/each}}</span>
					{{else}}<span class="muted">no attack modes</span>{{/if}}
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>
	{{else}}
	<p class="empty">No weapons ready. Equip or carry one from the Equipment tab.</p>
	{{/if}}

	{{!-- @MARKER MARTIAL ARTS
	      Martial Knowledge and Martial Lore, as one panel that opens from its heading. Closed it
	      is one line: the discipline, the stance held and the moves made. Open, it is the
	      discipline and stance to choose, the moves to make, and every subskill to roll.

	      The stance and discipline are ordinary form fields, so choosing one saves it and the
	      character re-derives: defence, initiative and weapon speed all follow the stance at once.
	      A move is MADE by its skill roll (the die beside it) and stays made until cleared -- his
	      move success box and SET button in one -- or is ticked by hand with the Game Master's
	      say-so. Everything here only feeds what attacks read; see module/combat/martial-arts.mjs. --}}
	{{#if martial.show}}
	<div class="martial-arts">
		<h3 class="section-head martial-head">
			<button type="button" class="martial-toggle" data-action="toggleMartialPanel"
				data-tooltip="{{#if martial.open}}Close{{else}}Open{{/if}} martial arts">
				<i class="fa-solid fa-caret-{{#if martial.open}}down{{else}}right{{/if}}"></i> Martial Arts</button>
			<span class="muted">{{martial.summary}}</span>
		</h3>

		{{#if martial.open}}
		<div class="martial-body">
			<div class="martial-row">
				<span class="martial-stat">Martial Knowledge <strong>{{martial.knowChance}}%</strong></span>
				{{#if martial.hasLore}}<span class="martial-stat">Martial Lore <strong>{{martial.loreChance}}%</strong></span>{{/if}}
				<label class="martial-stat">Discipline
					<select name="system.martial.discipline">
						{{#each martial.disciplineChoices as |d|}}<option value="{{d.value}}" {{#if d.selected}}selected{{/if}}>{{d.label}}</option>{{/each}}
					</select></label>
				<span class="martial-stat muted">From prone: {{martial.standFromProne}}</span>
			</div>
			{{#unless martial.hasKnowledge}}
			<p class="hint">Martial Knowledge is not held (or its title is not reached yet), so nothing here applies.</p>
			{{/unless}}
			{{#if martial.needsDiscipline}}
			<p class="hint">Choose a discipline: it decides which attacks, blocks, holds, moves and throws are known.
				Custom knows only what is written in the lists below.</p>
			{{/if}}

			{{!-- One stance at a time, entered in 3 seconds without a roll. A stance must be learned
			      (a Martial Knowledge roll) before it can be held, and mastered (Martial Lore) to use
			      its stronger form. --}}
			<div class="martial-row">
				<label class="martial-stat">Stance
					<select name="system.martial.activeStance">
						{{#each martial.stanceChoices as |s|}}<option value="{{s.value}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
					</select></label>
				<button type="button" data-action="learnMartialStance" data-tooltip="A Martial Knowledge roll">Learn a stance</button>
				{{#if martial.hasLore}}<button type="button" data-action="masterMartialStance" data-tooltip="A Martial Lore roll">Master a stance</button>{{/if}}
			</div>
			{{#if martial.stanceText}}<p class="martial-note">{{martial.stanceText}}</p>{{/if}}

			{{!-- What is in play, all of it, so the player can see what the next attack will read. --}}
			{{#if martial.effects.length}}
			<ul class="martial-effects">{{#each martial.effects as |e|}}<li>{{e}}</li>{{/each}}</ul>
			{{/if}}
			{{#if martial.illegal}}<p class="martial-note alarm">{{martial.illegal}}</p>{{/if}}

			{{#if martial.moves.length}}
			<h4 class="martial-sub">Moves <span class="muted">made moves add to the attacks after them</span>
				<button type="button" class="martial-clear" data-action="clearMartialMoves"
					data-tooltip="Clear every move and Martial Lore value made">Clear</button></h4>
			<div class="martial-moves">
				{{#each martial.moves as |m|}}
				<span class="martial-chip {{#if m.made}}on{{/if}}" data-tooltip="{{m.special}}">
					<button type="button" class="martial-chip-name" data-action="toggleMartialMove" data-name="{{m.name}}"
						data-tooltip="{{#if m.made}}Made -- click to clear{{else}}Mark as made (Game Master's say-so){{/if}}">{{m.name}}</button>
					<button type="button" data-action="rollMartialMove" data-name="{{m.name}}"
						data-tooltip="Roll {{m.chance}}% (shift-click for a modifier)"><i class="fa-solid fa-dice-d20"></i> {{m.chance}}%</button>
				</span>
				{{/each}}
			</div>
			{{/if}}

			{{#if martial.attacks.length}}
			<h4 class="martial-sub">Attacks <span class="muted">skill roll and roll to hit together; a failed skill roll still lands for half</span></h4>
			<table class="weapon-table martial-table">
				<thead><tr><th class="col-name">Attack</th><th class="col-num">Skill</th><th class="col-num">Speed</th>
					<th class="col-num">Damage</th><th>Notes</th><th></th></tr></thead>
				<tbody>
					{{#each martial.attacks as |a|}}
					<tr>
						<td class="col-name">{{a.name}}</td>
						<td class="col-num">{{a.chance}}%</td>
						<td class="col-num">{{a.speed}}</td>
						<td class="col-num">{{a.damage}} <span class="muted">{{a.damageType}}</span></td>
						<td class="martial-special">{{a.special}}</td>
						<td><button type="button" data-action="rollMartialAttack" data-name="{{a.name}}">
							<i class="fa-solid fa-dice-d20"></i> Attack</button></td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			{{/if}}

			{{#each martial.subskills as |f|}}
			<h4 class="martial-sub">{{f.label}} <span class="muted">{{f.hint}}</span></h4>
			<table class="weapon-table martial-table">
				<tbody>
					{{#each f.rows as |r|}}
					<tr>
						<td class="col-name">{{r.name}}</td>
						<td class="col-num">{{r.chance}}%</td>
						<td class="col-num">{{r.speedText}}s</td>
						<td class="martial-special">{{#if r.damage}}{{r.damage}} &middot; {{/if}}{{r.special}}</td>
						<td><button type="button" data-action="rollMartialSubskill" data-family="{{f.family}}" data-name="{{r.name}}"
							data-tooltip="Shift-click for a modifier"><i class="fa-solid fa-dice-d20"></i> Roll</button></td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			{{/each}}

			{{#if martial.hasLore}}
			<h4 class="martial-sub">Martial Lore <span class="muted">rolled against Martial Lore; a made value stays in play until cleared</span></h4>
			{{#if martial.lore.length}}
			<table class="weapon-table martial-table">
				<tbody>
					{{#each martial.lore as |l|}}
					<tr class="{{#if l.made}}martial-made{{/if}}">
						<td class="col-name">{{l.name}} <span class="muted">{{l.type}}</span></td>
						<td class="col-num">{{l.chance}}%</td>
						<td class="martial-special">{{l.special}}</td>
						<td class="col-hand"><span class="hand-pick"><button type="button" class="{{#if l.made}}on{{/if}}"
							data-action="toggleMartialLoreValue" data-name="{{l.name}}"
							data-tooltip="{{#if l.made}}Made -- click to clear{{else}}Mark as made{{/if}}">made</button></span></td>
						<td><button type="button" data-action="rollMartialLoreValue" data-name="{{l.name}}"
							data-tooltip="Shift-click for a modifier"><i class="fa-solid fa-dice-d20"></i> Roll</button></td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			{{/if}}
			<div class="martial-row">
				<button type="button" data-action="learnMartialLoreValue">Learn a Martial Lore value</button>
				<button type="button" data-action="learnMartialSubskill"
					data-tooltip="A subskill outside the discipline, seen from another martial artist">Learn a subskill with Martial Lore</button>
			</div>
			{{/if}}

			{{!-- His lists, as he keeps them: comma-separated names. A Custom discipline's picks live
			      here, and so does anything learned beyond the discipline; the Game Master can put a
			      slip right by hand. --}}
			<h4 class="martial-sub">Lists <span class="muted">comma-separated, as his sheet keeps them</span></h4>
			<div class="martial-lists">
				<div class="lore-lists">
					<label>Attacks beyond the discipline<input type="text" name="system.martial.learnedAttacks" value="{{system.martial.learnedAttacks}}" placeholder="Rake, Finger Punch"></label>
					<label>Blocks<input type="text" name="system.martial.learnedBlocks" value="{{system.martial.learnedBlocks}}" placeholder="Body Block"></label>
					<label>Holds<input type="text" name="system.martial.learnedHolds" value="{{system.martial.learnedHolds}}" placeholder="Torso"></label>
					<label>Moves<input type="text" name="system.martial.learnedMoves" value="{{system.martial.learnedMoves}}" placeholder="Tension"></label>
					<label>Throws<input type="text" name="system.martial.learnedThrows" value="{{system.martial.learnedThrows}}" placeholder="Spin Throw"></label>
					<label>Stances learned<input type="text" name="system.martial.stances" value="{{system.martial.stances}}" placeholder="Flow as water"></label>
					<label>Stances mastered<input type="text" name="system.martial.masteredStances" value="{{system.martial.masteredStances}}"></label>
					<label>Martial Lore values<input type="text" name="system.martial.loreValues" value="{{system.martial.loreValues}}" placeholder="Flip, Slam"></label>
				</div>
				{{#if martial.unknown}}<p class="martial-note alarm">Not in his tables, so ignored: {{martial.unknown}}</p>{{/if}}
			</div>
		</div>
		{{/if}}
	</div>
	{{/if}}

	{{!-- Handedness decides which side of the body a shield covers: a shield is held in the off
	      hand, so a right-hander is shielded down the left. Anything but "Left" reads as
	      right-handed, which is what his equipShield does. --}}
	{{!-- Rolled, not chosen, unless the Game Master has ticked the setting -- his sheet never
	      offers the choice. With the tick off the dropdown is GONE rather than disabled, and the
	      die beside the value is the only way to change it; see @MARKER HANDEDNESS in
	      imagine-rpg.mjs. --}}
	<h3 class="section-head">Body <span class="muted">{{system.body.type}}</span>
		<label class="handedness">Handedness
			{{#if handednessSelectable}}
			<select name="system.physical.handedness">
				{{#each handednessChoices as |h|}}
				<option value="{{h.value}}" {{#if h.selected}}selected{{/if}}>{{h.label}}</option>
				{{/each}}
			</select>
			{{else}}
			{{!-- No die here either, for the reason in the generator: a re-roll is a choice wearing
			      a dice icon. A character made by hand rather than generated still needs a first
			      roll, so the die appears only while the value is blank and goes once it is set. --}}
			<span class="rolled-value">{{handednessLabel}}</span>
			{{#unless system.physical.handedness}}
			<button type="button" data-action="rollHandedness" data-tooltip="Roll handedness once">
				<i class="fa-solid fa-dice"></i></button>
			{{/unless}}
			{{/if}}
		</label>
	</h3>
	<table class="body-table">
		<thead>
			<tr>
				<th class="col-name">Area</th>
				<th class="col-num">Endurance</th>
				<th class="col-num">Wounds</th>
				<th class="col-num">Armour</th>
				<th>State</th>
			</tr>
		</thead>
		<tbody>
			{{#each system.body.areas as |a|}}
			<tr class="area-{{a.state}}">
				<td class="col-name">{{a.name}} <span class="muted">{{a.type}}</span></td>
				<td class="col-num">{{a.endurance}}</td>
				{{!-- Wounds are stored state, not derived, so they can be healed by hand. --}}
				<td class="col-num"><input type="number" class="wound-input" min="0"
					name="system.body.wounds.{{a.name}}" value="{{a.wounds}}"></td>
				<td class="col-num" {{#if a.layers.length}}data-tooltip="{{#each a.layers as |l|}}{{l}}{{#unless @last}}, {{/unless}}{{/each}}"{{/if}}>
					{{#if a.protectedByArmor}}{{a.armor}}{{#if a.shield}} <span class="muted">({{a.shield}} shield)</span>{{/if}}{{#if a.armorDamage}} <span class="muted">(−{{a.armorDamage}})</span>{{/if}}{{else}}<span class="muted">—</span>{{/if}}</td>
				<td class="state">
					{{#if (eq a.state "effect")}}Effect triggered
					{{else if (eq a.state "vitalitySave")}}Vitality save
					{{else if (eq a.state "wounded")}}Wounded
					{{else}}<span class="muted">Sound</span>{{/if}}
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>
</section>

{{!--
	Shared item header: the picture, the name, and where the entry came from.

	Sourcebook and page are editable because homebrew content needs to say where it came from
	too, and because his own trait dictionaries carry neither, so a Game Master may want to
	fill them in.
--}}
<header class="imagine-header item">

	{{!-- data-action="editImage" opens the file picker (DocumentSheetV2); data-edit names the field. --}}
	<img class="portrait small" src="{{item.img}}" data-edit="img" data-action="editImage" alt="{{item.name}}">

	<div class="identity">
		<input class="charname" type="text" name="name" value="{{item.name}}" placeholder="Name">

		<div class="identity-line">
			<span class="field"><label>Sourcebook</label>
				<input type="text" name="system.sourcebook" value="{{system.sourcebook}}" placeholder="&mdash;"
					class="{{#if sourceUnknown}}source-unknown{{/if}}"></span>
			<span class="field"><label>Page</label>
				<input type="text" name="system.page" value="{{system.page}}" placeholder="&mdash;"></span>
		</div>
		{{#if sourceUnknown}}
		<p class="source-unknown-note">XXX &mdash; not found in his Master Index. Type the book
			and page over the XXX if you know them.</p>
		{{/if}}
	</div>
</header>

{{!--
	Class body. One root element, as the framework requires of every PART.

	Titles and class skills are two separate lists in his data -- classtitledict carries no skill
	column at all -- shown here paired by index because that is how a player actually reads them.
	classMods has no fixed width: it runs two to five entries across the 87 classes extracted so
	far, and Monk's row is a column short of everyone else's (UPSTREAM-ISSUES.md item 1). Rendered
	exactly as long as it is; a short list is not an error to hide.
--}}
<section class="imagine-item-body class">

	<div class="panel-row">
		<div class="panel">
			<h3>Spellcasting</h3>
			<ul class="band-list">
				<li><label>Casts Aura magic</label>
					<span><input type="checkbox" name="system.casting.isCaster" {{#if system.casting.isCaster}}checked{{/if}}></span></li>
				<li><label>Caster start title</label>
					<span><input type="number" name="system.casting.casterStartTitle" value="{{system.casting.casterStartTitle}}" min="0"></span></li>
				<li><label>Invokes Piety magic</label>
					<span><input type="checkbox" name="system.casting.isInvoker" {{#if system.casting.isInvoker}}checked{{/if}}></span></li>
				<li><label>Invoker start title</label>
					<span><input type="number" name="system.casting.invokerStartTitle" value="{{system.casting.invokerStartTitle}}" min="0"></span></li>
				<li><label>Commune title mod</label>
					<span><input type="number" name="system.casting.communeTitleMod" value="{{system.casting.communeTitleMod}}"></span></li>
				<li><label>Casting notes</label>
					<span><input type="text" name="system.casting.castingNotes" value="{{system.casting.castingNotes}}"></span></li>
			</ul>
		</div>

		<div class="panel">
			<h3>Requirements</h3>
			<ul class="band-list">
				<li><label>Focus attributes</label>
					<span><input type="text" name="system.requirements.focusAttributes" value="{{system.requirements.focusAttributes}}" placeholder="STR, AGL"></span></li>
			</ul>
			{{!-- Alignment ran to 47 characters for Vivisectionist ("Evil (Active), Fanatical Evil
			      (Active), Immoral") -- too long for the band-list's field, which is sized for a
			      one-word answer like "Any". Wide-field instead, same fix as the race sheet's
			      skill note. --}}
			<label class="wide-field">Alignment
				<input type="text" name="system.requirements.alignment" value="{{system.requirements.alignment}}"
					title="{{system.requirements.alignment}}"></label>
		</div>

		<div class="panel">
			<h3>Classification</h3>
			<ul class="band-list">
				<li><label>Class skill slots needed</label>
					<span><input type="number" name="system.skillSlotsNeeded" value="{{system.skillSlotsNeeded}}" min="0"></span></li>
			</ul>
			<p class="muted">Slots needed runs 36 to 56 across his classes. Zero means the class costs no
			class skill slots at all &mdash; true of GME, and otherwise a sign the figure is simply not
			known yet.</p>
		</div>
	</div>

	{{!-- Class type, armour usage and weapon usage were single-line band-list inputs sized for
	      "Warrior subclass", but his real data runs to whole paragraphs -- Kineticist's armour
	      usage is 376 characters ("Cloth, leather, and wood only. Clasps, buckles, jewelry..."),
	      well past anything a one-line field or a title tooltip could make readable. Textareas
	      instead, the same as Description below, so his longer entries are read rather than
	      guessed at. --}}
	<div class="panel-row">
		<div class="panel">
			<h3>Class Type</h3>
			<textarea name="system.classType" rows="3" placeholder="Warrior subclass">{{system.classType}}</textarea>
		</div>
		<div class="panel">
			<h3>Armour Usage</h3>
			<textarea name="system.armorUsage" rows="3">{{system.armorUsage}}</textarea>
		</div>
		<div class="panel">
			<h3>Weapon Usage</h3>
			<textarea name="system.weaponUsage" rows="3">{{system.weaponUsage}}</textarea>
		</div>
	</div>

	<div class="panel-row">
		<div class="panel">
			<h3>Attack Progression</h3>
			<ul class="band-list">
				<li><label>Attack skill</label>
					<span><input type="text" name="system.attackSkill" value="{{system.attackSkill}}"></span></li>
			</ul>
			{{!-- attackSkillList runs to 126 characters for Cacophonist -- a whole title
			      progression sentence, not a value a one-line band-list field can show. --}}
			<label class="wide-field">Attack skill list
				<input type="text" name="system.attackSkillList" value="{{system.attackSkillList}}"
					title="{{system.attackSkillList}}"></label>
		</div>

		<div class="panel">
			<h3>Lore Titles</h3>
			<ul class="band-list">
				<li><label>Lore attack chart</label>
					<span><input type="number" name="system.loreAttackTitle" value="{{system.loreAttackTitle}}" min="0"></span></li>
				<li><label>Weapon Lore</label>
					<span><input type="number" name="system.weaponLoreTitle" value="{{system.weaponLoreTitle}}" min="0"></span></li>
				<li><label>Missile Lore</label>
					<span><input type="number" name="system.missileLoreTitle" value="{{system.missileLoreTitle}}" min="0"></span></li>
				<li><label>Projectile Lore</label>
					<span><input type="number" name="system.projectileLoreTitle" value="{{system.projectileLoreTitle}}" min="0"></span></li>
			</ul>
			<p class="muted">Zero means the class never gets it. This is the Lore chart threshold, not the
			mastered-weapons title in the attack skill list above -- the two disagree for every class that
			carries both.</p>
		</div>
	</div>

	<h3 class="section-head">Attribute Qualification</h3>
	<table class="attr-grid">
		<thead>
			<tr>{{#each attribQualifyCells as |c|}}<th>{{c.key}}</th>{{/each}}</tr>
		</thead>
		<tbody>
			<tr>
				{{#each attribQualifyCells as |c|}}
				<td><input type="number" name="system.requirements.attribQualify.{{c.index}}" value="{{c.value}}" min="0"></td>
				{{/each}}
			</tr>
		</tbody>
	</table>
	<p class="muted">The minimum rating a character needs in each attribute to take this class. Zero
	means no requirement.</p>

	<h3 class="section-head">Class Modifiers
		<button type="button" data-action="addClassMod"><i class="fa-solid fa-plus"></i> Add</button>
	</h3>
	{{#if classModRows.length}}
	<ul class="band-list removable-list">
		{{#each classModRows as |m|}}
		<li>
			<input type="text" name="system.classMods.{{m.index}}" value="{{m.value}}">
			<button type="button" data-action="deleteClassMod" data-index="{{m.index}}"
				data-tooltip="Remove this modifier"><i class="fa-solid fa-trash"></i></button>
		</li>
		{{/each}}
	</ul>
	{{else}}
	<p class="empty">No class modifiers.</p>
	{{/if}}
	<p class="muted">His sheet encodes these as display strings it pattern-matches on. Kept here as the
	text a player reads; the mechanical effect belongs on an Active Effect on this item.</p>

	<h3 class="section-head">Titles and Class Skills
		<span class="count">{{titleRows.length}}</span>
		<button type="button" data-action="addTitle"><i class="fa-solid fa-plus"></i> Add</button>
	</h3>
	{{#if titleRows.length}}
	{{#each titleRows as |t|}}
	<details class="skill-group rider" data-sync="title-{{t.index}}">
		<summary>Title {{t.number}}{{#if t.name}}: {{t.name}}{{/if}}
			<button type="button" data-action="deleteTitle" data-index="{{t.index}}"
				data-tooltip="Remove this title"><i class="fa-solid fa-trash"></i></button>
		</summary>
		<ul class="band-list">
			<li><label>Title name</label>
				<span><input type="text" name="system.advancement.titles.{{t.index}}" value="{{t.name}}"></span></li>
			<li><label>Class skills</label>
				<span><input type="text" name="system.advancement.classSkills.{{t.index}}" value="{{t.skills}}"
					placeholder="his classtitledict carries no skill column -- left blank until authored"></span></li>
		</ul>
	</details>
	{{/each}}
	{{else}}
	<p class="empty">No titles.</p>
	{{/if}}

	<h3 class="section-head">Goal Attributes</h3>
	<ul class="band-list">
		<li><label>First</label>
			<span><input type="text" name="system.advancement.goalAttr1" value="{{system.advancement.goalAttr1}}"></span></li>
		<li><label>Second</label>
			<span><input type="text" name="system.advancement.goalAttr2" value="{{system.advancement.goalAttr2}}"></span></li>
	</ul>

	{{!-- What the class GIVES and requires, as opposed to what it modifies -- the same omission
	      item 1 of 2026-09-20-first-install-bugs.md found on the race sheet: blockedRaces,
	      classSkillList, nonClassed, baseClass/path and archMortal were all stored and read by the
	      character but shown nowhere on the class itself. Chips, not editable rows, and no
	      add/remove buttons -- the SAME call the race sheet already made for racialSkills,
	      abilities, disabilities, immunities and fertileWith: these come from his tables, and a
	      Game Master who wants to change one uses the raw-data editor. (2026-09-18-races-classes.md
	      item 1 once asked for classSkillList as editable rows with a requires dropdown;
	      2026-09-20-first-install-bugs.md item 1 is the later call and this follows it.)

	      His own racialSkills/abilities chips on the race sheet stay read-only by the same
	      decision -- see that template's comment above "What This Race Gives". --}}
	<h3 class="section-head">What This Class Gives</h3>
	<div class="panel race-panel">
		<p><label>Base class</label>
			{{#if system.baseClass}}<span>{{system.baseClass}}</span>{{else}}<span class="muted">is a base class</span>{{/if}}</p>
		{{#if system.path}}<p><label>Path</label> <span>{{system.path}}</span></p>{{/if}}
		{{#if system.nonClassed}}<p><label>Non-classed</label>
			<span class="race-chip">no class skills, no racial title-1 Endurance bonus</span></p>{{/if}}

		<p><label>Blocked races</label>
			{{#each system.blockedRaces as |r|}}<span class="race-chip">{{r}}</span>{{else}}<span class="muted">none -- any race may take this class</span>{{/each}}</p>

		<p><label>Class skills</label>
			{{#each classSkillListRows as |s|}}<span class="race-chip" title="{{s.requiresLabel}}">T{{s.title}} {{s.name}}{{#if s.core}} (core){{/if}}</span>{{else}}<span class="muted">none listed -- his classtitledict carries no skill column; see the Titles and Class Skills section above</span>{{/each}}</p>
		<p class="muted">Hover a chip for which races it requires. "Core" marks the class's own +30%
		skills, from his setClassSkillLists.</p>
	</div>

	{{!-- ARCH MORTAL. What a character of this class must hold before passing 10th title, from his
	      archmortalqualifylist. Attribute entries are HIS OWN STRINGS, not numbers -- "RM" means
	      the character's racial maximum, and a negative number means that maximum plus the number,
	      floored at 0 -- so they are shown as written rather than resolved, which only a character
	      (not the class alone) can do. Empty attribute entries are omitted; a race with no
	      requirement at all shows nothing. --}}
	{{#if archMortalAttributeRows.length}}
	<h3 class="section-head">Arch Mortal Qualifications</h3>
	<div class="panel race-panel">
		<p><label>Attributes</label>
			{{#each archMortalAttributeRows as |a|}}<span class="race-chip">{{a.key}} {{a.value}}</span>{{/each}}</p>
		{{#if system.archMortal.skills.length}}<p><label>Skills</label>
			{{#each system.archMortal.skills as |s|}}<span class="race-chip">{{s.name}} {{s.chance}}%</span>{{/each}}</p>{{/if}}
		{{#if system.archMortal.special}}<p><label>Special</label> <span>{{system.archMortal.special}}</span></p>{{/if}}
		<p class="muted">Also required: holding any power at all, which is not a field here because it
		is simply having one. "RM" is the character's own racial maximum for that attribute.</p>
	</div>
	{{/if}}

	<h3 class="section-head">Description</h3>
	<textarea name="system.description" rows="5">{{system.description}}</textarea>
</section>

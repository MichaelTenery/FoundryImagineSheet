{{!--
	Race body. One root element, as the framework requires of every PART.

	A race supplies three kinds of thing: modifiers to attributes, characteristics and resistances;
	a per-race cap on each attribute, separate from and stricter than the being-type cap that title
	confers; and movement rates. These are read directly by the character rather than turned into
	Active Effects, because a race is permanent character definition -- see item-race.mjs.
--}}
<section class="imagine-item-body race">

	<h3 class="section-head">Attribute Mods and Limits</h3>
	<table class="attr-grid">
		<thead>
			<tr><th></th>{{#each attributeKeys as |k|}}<th>{{k}}</th>{{/each}}</tr>
		</thead>
		<tbody>
			{{#each attributeRows as |row|}}
			<tr>
				<td class="row-label">{{row.label}}</td>
				{{#each row.cells as |c|}}
				<td><input type="number" name="system.{{row.group}}.{{c.key}}" value="{{c.value}}"></td>
				{{/each}}
			</tr>
			{{/each}}
		</tbody>
	</table>
	<p class="muted">Mods are added to the character's rating. Limits are the highest rating a member
	of this race may reach in each attribute -- the field <code>getAttributeMax</code> reads, and
	load-bearing rather than decorative. Title 11 and above discards it: 25 becomes the ordinary
	maximum and 27 the magical one, the pair he confirmed on 2026-09-16 (UPSTREAM-ISSUES item 16).</p>

	<div class="panel-row">
		<div class="panel">
			<h3>Endurance</h3>
			<ul class="band-list">
				<li><label>Start formula</label>
					<span><input type="text" name="system.endurance.startFormula" value="{{system.endurance.startFormula}}" placeholder="2d6"></span></li>
				<li><label>Start mod</label>
					<span><input type="number" name="system.endurance.startMod" value="{{system.endurance.startMod}}"></span></li>
				{{!-- Only a start formula with a die is rolled (Gaunt's -1d4): once, into the character's
				      own copy -- by the generator, when the race is dropped on a character, or from the
				      header's Roll button -- where it is added to Start mod and this is ticked so it is
				      never rolled twice. A race document itself is never ticked. --}}
				<li><label>Start rolled</label>
					<span><input type="checkbox" name="system.endurance.startRolled" {{#if system.endurance.startRolled}}checked{{/if}}></span></li>
				<li><label>Title formula</label>
					<span><input type="text" name="system.endurance.titleFormula" value="{{system.endurance.titleFormula}}"></span></li>
				<li><label>Title dice</label>
					<span><input type="text" name="system.endurance.titleDice" value="{{system.endurance.titleDice}}" placeholder="1d4+1"></span></li>
				<li><label>Title max</label>
					<span><input type="number" name="system.endurance.titleMax" value="{{system.endurance.titleMax}}"></span></li>
				<li><label>Title mod</label>
					<span><input type="number" name="system.endurance.titleMod" value="{{system.endurance.titleMod}}"></span></li>
			</ul>
			<p class="muted">Gained on each title advance is rolled rather than fixed, which is why the
			dice and maximum are carried separately from the flat modifier.</p>
		</div>

		<div class="panel">
			<h3>Characteristics</h3>
			<ul class="band-list">
				<li><label>Perception</label>
					<span><input type="number" name="system.characteristicMods.perception" value="{{system.characteristicMods.perception}}"></span></li>
				<li><label>Affinity</label>
					<span><input type="number" name="system.characteristicMods.affinity" value="{{system.characteristicMods.affinity}}"></span></li>
				<li><label>Fortune</label>
					<span><input type="number" name="system.characteristicMods.fortune" value="{{system.characteristicMods.fortune}}"></span></li>
			</ul>
		</div>

		<div class="panel">
			<h3>Resistances</h3>
			<ul class="resist-list">
				<li><label>Magic</label>
					<span><input type="number" name="system.resistanceMods.magic" value="{{system.resistanceMods.magic}}"></span></li>
				<li><label>Illusion</label>
					<span><input type="number" name="system.resistanceMods.illusion" value="{{system.resistanceMods.illusion}}"></span></li>
				<li><label>Control</label>
					<span><input type="number" name="system.resistanceMods.control" value="{{system.resistanceMods.control}}"></span></li>
				<li><label>Poison</label>
					<span><input type="number" name="system.resistanceMods.poison" value="{{system.resistanceMods.poison}}"></span></li>
				<li><label>Disease</label>
					<span><input type="number" name="system.resistanceMods.disease" value="{{system.resistanceMods.disease}}"></span></li>
			</ul>
		</div>
	</div>

	<div class="panel-row">
		<div class="panel">
			<h3>Traits</h3>
			<ul class="band-list">
				<li><label>Formless</label>
					<span><input type="checkbox" name="system.formless" {{#if system.formless}}checked{{/if}}></span></li>
				<li><label>Can swim</label>
					<span><input type="checkbox" name="system.canSwim" {{#if system.canSwim}}checked{{/if}}></span></li>
				<li><label>Body type</label>
					<span><input type="text" name="system.bodyType" value="{{system.bodyType}}" placeholder="Humanoid"></span></li>
			</ul>
			<p class="muted">Formless marks a race with no fixed body, which matters to the body chart
			and to transformation.</p>
		</div>

		<div class="panel">
			<h3>Movement</h3>
			<ul class="band-list">
				<li><label>Speed multiplier</label>
					<span><input type="number" name="system.movement.speedMultiplier" value="{{system.movement.speedMultiplier}}"></span></li>
				<li><label>Jump, standing</label>
					<span><input type="number" name="system.movement.jumpStand" value="{{system.movement.jumpStand}}"></span></li>
				<li><label>Jump, running</label>
					<span><input type="number" name="system.movement.jumpUp" value="{{system.movement.jumpUp}}"></span></li>
			</ul>
			<p class="muted">0 here means no multiplier -- his sentinel for "most races", not a
			stationary race. A negative multiplier is not a coherent quantity and is ignored the same
			way rather than applied; see UPSTREAM-ISSUES.md item 24.</p>
		</div>
	</div>

	{{!-- formlessHosts is a new array field with nowhere to edit it -- the same gap item 1 of
	      2026-09-18-races-classes.md records for racialSkills, abilities and the rest. One
	      comma-separated field, split on save in _processFormData, same as a skill's types.
	      Shown for every race rather than gated on isFormless: it is empty for the 106 races
	      that cannot be a Formless's host and populated only for Formless itself, and an empty
	      field reads as "not applicable" without needing a conditional. --}}
	<label class="wide-field">Formless hosts
		<input type="text" name="system.formlessHosts" value="{{formlessHostsText}}"
			placeholder="empty for every race but Formless itself"></label>
	<p class="muted">The races a Formless psyche may inhabit as its host body -- from his
	formlessStartingRaceDetails. Comma-separated here; split into a list on save.</p>

	<h3 class="section-head">Walk, Jog, Run</h3>
	<table class="move-table edit-move-table">
		<thead><tr><th></th><th>Hourly</th><th>10 sec</th><th>1 sec</th></tr></thead>
		<tbody>
			<tr>
				<td>Walk</td>
				<td><input type="number" name="system.movement.walk.hourly" value="{{system.movement.walk.hourly}}"></td>
				<td><input type="number" name="system.movement.walk.tenSec" value="{{system.movement.walk.tenSec}}"></td>
				<td><input type="number" name="system.movement.walk.oneSec" value="{{system.movement.walk.oneSec}}"></td>
			</tr>
			<tr>
				<td>Jog</td>
				<td><input type="number" name="system.movement.jog.hourly" value="{{system.movement.jog.hourly}}"></td>
				<td><input type="number" name="system.movement.jog.tenSec" value="{{system.movement.jog.tenSec}}"></td>
				<td><input type="number" name="system.movement.jog.oneSec" value="{{system.movement.jog.oneSec}}"></td>
			</tr>
			<tr>
				<td>Run</td>
				<td><input type="number" name="system.movement.run.hourly" value="{{system.movement.run.hourly}}"></td>
				<td><input type="number" name="system.movement.run.tenSec" value="{{system.movement.run.tenSec}}"></td>
				<td><input type="number" name="system.movement.run.oneSec" value="{{system.movement.run.oneSec}}"></td>
			</tr>
		</tbody>
	</table>
	<p class="muted">These are the race's own modifiers to the Agility-derived base rate, not finished
	speeds -- see combat-rules.mjs's getMovementBase. A race field of 0 means no adjustment at that
	scale, not zero movement.</p>

	<h3 class="section-head">Special Movement</h3>
	<ul class="band-list">
		<li><label>Name</label>
			<span><input type="text" name="system.movement.specialName" value="{{system.movement.specialName}}" placeholder="Fly:"></span></li>
	</ul>
	<table class="move-table edit-move-table">
		<thead><tr><th></th><th>Base rate</th><th>Multiplier</th><th>Mod</th></tr></thead>
		<tbody>
			<tr>
				<td>Hourly</td>
				<td><input type="text" name="system.movement.special.hourly" value="{{system.movement.special.hourly}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.special.hourlyMultiplier" value="{{system.movement.special.hourlyMultiplier}}"></td>
				<td><input type="number" name="system.movement.special.hourlyMod" value="{{system.movement.special.hourlyMod}}"></td>
			</tr>
			<tr>
				<td>10 sec</td>
				<td><input type="text" name="system.movement.special.tenSec" value="{{system.movement.special.tenSec}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.special.tenSecMultiplier" value="{{system.movement.special.tenSecMultiplier}}"></td>
				<td><input type="number" name="system.movement.special.tenSecMod" value="{{system.movement.special.tenSecMod}}"></td>
			</tr>
			<tr>
				<td>1 sec</td>
				<td><input type="text" name="system.movement.special.oneSec" value="{{system.movement.special.oneSec}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.special.oneSecMultiplier" value="{{system.movement.special.oneSecMultiplier}}"></td>
				<td><input type="number" name="system.movement.special.oneSecMod" value="{{system.movement.special.oneSecMod}}"></td>
			</tr>
		</tbody>
	</table>
	<p class="muted">Base rate names the rate this scale derives from -- "Walk", "Run", or "INT" for
	magical flight, which reads the Intelligence attribute directly instead. Five formula shapes
	exist across the kinds (Fly, Gallop, Swim, Scurry, Slither); see resolveSpecialMovement in
	combat-rules.mjs. Leave the name blank for a race with no special movement.</p>

	{{!-- A second special movement, read exactly as the first. Only a Nixie has one (it swims AND
	      flies, Legends p.33); blank for every other race. --}}
	<h3 class="section-head">Second Special Movement</h3>
	<ul class="band-list">
		<li><label>Name</label>
			<span><input type="text" name="system.movement.secondSpecialName" value="{{system.movement.secondSpecialName}}" placeholder="Swim:"></span></li>
	</ul>
	<table class="move-table edit-move-table">
		<thead><tr><th></th><th>Base rate</th><th>Multiplier</th><th>Mod</th></tr></thead>
		<tbody>
			<tr>
				<td>Hourly</td>
				<td><input type="text" name="system.movement.secondSpecial.hourly" value="{{system.movement.secondSpecial.hourly}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.secondSpecial.hourlyMultiplier" value="{{system.movement.secondSpecial.hourlyMultiplier}}"></td>
				<td><input type="number" name="system.movement.secondSpecial.hourlyMod" value="{{system.movement.secondSpecial.hourlyMod}}"></td>
			</tr>
			<tr>
				<td>10 sec</td>
				<td><input type="text" name="system.movement.secondSpecial.tenSec" value="{{system.movement.secondSpecial.tenSec}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.secondSpecial.tenSecMultiplier" value="{{system.movement.secondSpecial.tenSecMultiplier}}"></td>
				<td><input type="number" name="system.movement.secondSpecial.tenSecMod" value="{{system.movement.secondSpecial.tenSecMod}}"></td>
			</tr>
			<tr>
				<td>1 sec</td>
				<td><input type="text" name="system.movement.secondSpecial.oneSec" value="{{system.movement.secondSpecial.oneSec}}" placeholder="Walk"></td>
				<td><input type="number" name="system.movement.secondSpecial.oneSecMultiplier" value="{{system.movement.secondSpecial.oneSecMultiplier}}"></td>
				<td><input type="number" name="system.movement.secondSpecial.oneSecMod" value="{{system.movement.secondSpecial.oneSecMod}}"></td>
			</tr>
		</tbody>
	</table>

	{{!-- What the race GIVES, as opposed to what it modifies. This block used to be missing
	      altogether: the sheet showed a race's numbers and none of its skills, abilities or
	      colours, so opening Nixie in the compendium gave no hint that its Animal Shape is water
	      animals only -- the racialSkillNote was stored, and read by the character sheet, but
	      never shown where a Game Master goes to read the race. Reported by Daryl on 2026-09-20.

	      Shown as chips rather than as fields, in the same markup the character's Description tab
	      uses for the same data, so a race reads the same in both places. These lists come from
	      his tables and are edited through the raw-data editor on the rare occasion a Game Master
	      wants to change one -- the note, which is prose about the skills, is editable here. --}}
	<h3 class="section-head">What This Race Gives</h3>
	<div class="panel race-panel">
		{{!-- RACE FORMS. sourceRace and physiqueLock are read-only here: a form is a document of
		      its own (Fairy(Winged), Maginos(Metal)) and both fields say where it came from and
		      what its wings/build choice is locked to. Nixie shows neither -- its sourceRace
		      equals its own name and its physiqueLock is empty, which is every race that is not
		      one of his split forms. See resolvePhysiqueLock in race-rules.mjs, which is the
		      function that reads physiqueLock at play; this is display only. --}}
		{{#if system.physiqueLock}}
		<p><label>Form</label>
			{{#if (eq system.physiqueLock "slight")}}<span>winged (always slight physique)</span>{{/if}}
			{{#if (eq system.physiqueLock "ordinary")}}<span>wingless (never slight physique)</span>{{/if}}</p>
		{{/if}}
		{{#if system.sourceRace}}{{#unless (eq system.sourceRace item.name)}}
		<p><label>Source race</label> <span>{{system.sourceRace}}</span></p>
		{{/unless}}{{/if}}
		<p><label>Racial skills</label>
			{{#each system.racialSkills as |s|}}<span class="race-chip">{{s.name}}{{#if s.bonus}} {{s.bonus}}{{/if}}</span>{{else}}<span class="muted">none listed</span>{{/each}}</p>
		{{#if system.abilities.length}}<p><label>Abilities</label>
			{{#each system.abilities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
		{{#if system.disabilities.length}}<p><label>Disabilities</label>
			{{#each system.disabilities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
		{{#if system.immunities.length}}<p><label>Immunities</label>
			{{#each system.immunities as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
		{{#if system.fertileWith.length}}<p><label>Fertile with</label>
			{{#each system.fertileWith as |a|}}<span class="race-chip">{{a}}</span>{{/each}}</p>{{/if}}
		{{!-- SLIGHT PHYSIQUE. Only Gremlin carries a variant now that the four faeries became
		      documents of their own (DECISIONS.md 2026-09-21, "The races he split with a second
		      dropdown become races of their own") -- but the schema stays open for a homebrew
		      race to declare one. An empty racialSkills on the variant means "same as the
		      ordinary form", NOT "no skills" -- applySlightPhysique in race-rules.mjs makes the
		      same distinction, and Podling's own (unbuilt) variant would be empty for that
		      reason, not because it has none. --}}
		{{#if system.slightPhysique.hasVariant}}
		<p><label>Slight-physique form</label>
			{{#if system.slightPhysique.specialName}}<span class="race-chip">{{system.slightPhysique.specialName}}</span>{{else}}<span class="muted">no special movement</span>{{/if}}</p>
		<p><label>&nbsp;&nbsp;its skills</label>
			{{#if system.slightPhysique.racialSkills.length}}
				{{#each system.slightPhysique.racialSkills as |s|}}<span class="race-chip">{{s.name}}{{#if s.bonus}} {{s.bonus}}{{/if}}</span>{{/each}}
			{{else}}
				{{#each system.racialSkills as |s|}}<span class="race-chip">{{s.name}}{{#if s.bonus}} {{s.bonus}}{{/if}}</span>{{else}}<span class="muted">none listed</span>{{/each}}
				<span class="muted">(same as the ordinary form)</span>
			{{/if}}</p>
		{{/if}}
	</div>
	{{!-- On its own line rather than in a band-list: the note is a sentence, and the band-list's
	      label-and-field split left it about 90px wide, clipping Nixie's at "(water anim".

	      NO PLACEHOLDER. It used to carry Nixie's note as an example, and a greyed example in an
	      empty field reads as the race's own data: every race without a note appeared to say
	      "Animal Shape: (water animals only)". Reported in play-testing on 2026-09-22. --}}
	<label class="wide-field">Skill note
		<input type="text" name="system.racialSkillNote" value="{{system.racialSkillNote}}"></label>
	<p class="muted">The skill note is the qualification his sheet prints beside the racial skills --
	which forms a shapechanger may take, which sense works only in daylight. It is prose, and
	nothing reads it automatically.</p>

	{{!-- FAMORIAN. Shown only for the one race that is (isFamorian), his beast-blooded race whose
	      body is BUILT rather than fixed -- see item-race.mjs @MARKER FAMORIAN and
	      docs/sonnet/2026-09-21-famorian.md. Nobody hand-authors a second Famorian, so this is a
	      lower priority than the other list fields, but the gap is the same one item 2 of
	      2026-09-21-formless-and-resistances.md closed for formlessHosts.

	      The breed table is small (seven rows in his own data) and worth editing in place, the
	      same removable-row pattern the class sheet's Class Modifiers use. The evoke catalogue is
	      about 120 entries and is NOT -- full editing of that is disproportionate to what a Game
	      Master actually needs here, so it is read-only chips, same as racialSkills and the trait
	      lists above, with the detail text on hover rather than in a fourth column nobody can
	      read at this width. --}}
	{{#if system.famorian.isFamorian}}
	<h3 class="section-head">Famorian
		<button type="button" data-action="addFamorianBreed"><i class="fa-solid fa-plus"></i> Add breed</button>
	</h3>
	{{#if famorianBreedRows.length}}
	<table class="move-table edit-move-table famorian-breed-table">
		<thead><tr><th>Breed</th><th>d100 low</th><th>d100 high</th><th>Evokes</th><th>When</th><th></th></tr></thead>
		<tbody>
			{{#each famorianBreedRows as |b|}}
			<tr>
				<td><input type="text" name="system.famorian.breeds.{{b.index}}.breed" value="{{b.breed}}"></td>
				<td><input type="number" name="system.famorian.breeds.{{b.index}}.low" value="{{b.low}}"></td>
				<td><input type="number" name="system.famorian.breeds.{{b.index}}.high" value="{{b.high}}"></td>
				<td><input type="text" name="system.famorian.breeds.{{b.index}}.evokes" value="{{b.evokes}}"></td>
				<td><input type="text" name="system.famorian.breeds.{{b.index}}.when" value="{{b.when}}"></td>
				<td><button type="button" data-action="deleteFamorianBreed" data-index="{{b.index}}"
					data-tooltip="Remove this breed"><i class="fa-solid fa-trash"></i></button></td>
			</tr>
			{{/each}}
		</tbody>
	</table>
	{{else}}
	<p class="empty">No breed table.</p>
	{{/if}}
	<p class="muted">The d100 breed roll on character creation sets how many evokes a Famorian may
	take, whether they are always on or only under stress, and whether one animal package or more
	than one applies -- see module/famorian-rules.mjs.</p>

	<p><label>Evoke catalogue</label>
		{{#each system.famorian.evokes as |e|}}<span class="race-chip" title="{{e.detail}}">{{e.label}}</span>{{else}}<span class="muted">none listed</span>{{/each}}</p>
	<p class="muted">Read-only: his own list of about 120 beast traits, edited through the raw-data
	editor on the rare occasion a Game Master wants to change one. Only fifteen change a number
	(famorian-rules.mjs, each citing his sheet-worker.js line); the rest are descriptive, exactly as
	racial abilities above are. Hover a chip for its detail text.</p>
	{{/if}}

	<h3 class="section-head">Colouring and Age</h3>
	<div class="panel-row">
		<div class="panel">
			<h3>Colours</h3>
			<p class="muted">Hair, eyes and skin a member of this race is found in -- what the
			&ldquo;Roll colours&rdquo; button on a character offers.</p>
			<p><label>Hair</label>
				{{#each system.features.hair as |c|}}<span class="race-chip">{{c}}</span>{{else}}<span class="muted">none listed</span>{{/each}}</p>
			<p><label>Eyes</label>
				{{#each system.features.eyes as |c|}}<span class="race-chip">{{c}}</span>{{else}}<span class="muted">none listed</span>{{/each}}</p>
			<p><label>Skin</label>
				{{#each system.features.skin as |c|}}<span class="race-chip">{{c}}</span>{{else}}<span class="muted">none listed</span>{{/each}}</p>
		</div>
		<div class="panel">
			<h3>Age</h3>
			<ul class="band-list">
				<li><label>Starting, low</label>
					<span><input type="number" name="system.ages.startLow" value="{{system.ages.startLow}}"></span></li>
				<li><label>Starting, high</label>
					<span><input type="number" name="system.ages.startHigh" value="{{system.ages.startHigh}}"></span></li>
				<li><label>Maximum</label>
					<span><input type="text" name="system.ages.maxAge" value="{{system.ages.maxAge}}"
						placeholder="5000" title="{{system.ages.maxAge}}"></span></li>
			</ul>
			<p class="muted">Maximum age is a number of years for most races and a word for a few
			&mdash; &ldquo;Immortal&rdquo; &mdash; so it is text rather than a number.</p>
		</div>
	</div>

	<h3 class="section-head">Description</h3>
	<textarea name="system.description" rows="4">{{system.description}}</textarea>
</section>
